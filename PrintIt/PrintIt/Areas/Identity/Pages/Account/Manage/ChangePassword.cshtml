@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="space-y-8">
    <div class="flex items-center gap-4 border-b border-slate-100 pb-4">
        <div class="p-3 bg-brand-primary/10 rounded-xl">
            <i class="bi bi-shield-lock-fill text-brand-primary text-2xl"></i>
        </div>
        <h3 class="text-2xl font-bold text-brand-dark">@ViewData["Title"]</h3>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="max-w-xl">
        <form id="change-password-form" method="post" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-xs bg-red-50 p-3 rounded-lg mb-4" role="alert"></div>

            <div>
                <label asp-for="Input.OldPassword" class="block text-xs font-bold uppercase tracking-widest text-slate-400 mb-1 ml-1">Current Password</label>
                <input asp-for="Input.OldPassword"
                       class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-none transition-all placeholder:text-slate-400"
                       autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                <span asp-validation-for="Input.OldPassword" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Input.NewPassword" class="block text-xs font-bold uppercase tracking-widest text-slate-400 mb-1 ml-1">New Password</label>
                <input asp-for="Input.NewPassword"
                       class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-none transition-all placeholder:text-slate-400"
                       autocomplete="new-password" aria-required="true" placeholder="Minimum 6 characters" />
                <span asp-validation-for="Input.NewPassword" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Input.ConfirmPassword" class="block text-xs font-bold uppercase tracking-widest text-slate-400 mb-1 ml-1">Confirm New Password</label>
                <input asp-for="Input.ConfirmPassword"
                       class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-none transition-all placeholder:text-slate-400"
                       autocomplete="new-password" aria-required="true" placeholder="Repeat new password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div class="pt-2">
                <button type="submit"
                        class="w-full md:w-auto px-10 py-4 bg-brand-dark hover:bg-brand-primary text-white font-bold rounded-xl shadow-lg hover:shadow-brand-primary/30 transition-all active:scale-[0.98]">
                    Update Password
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}