@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Лични данни";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="space-y-8">
    @* Header Section *@
    <div class="flex items-center gap-5 border-b border-slate-100 pb-6">
        <div class="p-3 bg-brand-primary/10 rounded-2xl">
            <i class="bi bi-file-earmark-lock-fill text-brand-primary text-2xl"></i>
        </div>
        <div>
            <h3 class="text-2xl font-black text-brand-dark">@ViewData["Title"]</h3>
            <p class="text-slate-500 text-base">Управлявайте информацията, която съхраняваме за вас.</p>
        </div>
    </div>

    <div class="max-w-2xl space-y-8">
        @* Information Box *@
        <div class="bg-white border border-slate-200 rounded-[2rem] p-8 shadow-sm">
            <p class="text-slate-600 text-lg leading-relaxed mb-6">
                Вашият акаунт съдържа лични данни, които сте ни предоставили. Тази страница ви позволява да изтеглите или окончателно да изтриете тези данни.
            </p>

            @* Danger Zone Warning *@
            <div class="p-5 bg-red-50 border border-red-100 rounded-2xl flex gap-4 items-start">
                <i class="bi bi-exclamation-triangle-fill text-red-600 text-xl mt-0.5"></i>
                <div>
                    <strong class="block text-red-800 text-base font-bold mb-1">Внимание!</strong>
                    <p class="text-sm text-red-700 leading-relaxed">
                        Изтриването на тези данни ще <strong>премахне за постоянно вашия акаунт</strong>. Това действие е необратимо и данните не могат да бъдат възстановени.
                    </p>
                </div>
            </div>
        </div>

        @* Action Buttons *@
        <div class="flex flex-wrap gap-4 pt-2">
            <form id="download-data" asp-page="DownloadPersonalData" method="post" class="inline-block">
                <button type="submit"
                        class="px-8 py-4 bg-brand-dark hover:bg-brand-primary text-white font-black rounded-2xl shadow-lg shadow-brand-dark/20 transition-all flex items-center gap-3 text-base active:scale-[0.98]">
                    <i class="bi bi-download text-lg"></i> Изтегли моите данни
                </button>
            </form>

            <a id="delete" asp-page="DeletePersonalData"
               class="px-8 py-4 bg-white border-2 border-red-100 text-red-600 hover:bg-red-600 hover:text-white font-black rounded-2xl transition-all flex items-center gap-3 text-base shadow-sm active:scale-[0.98]">
                <i class="bi bi-trash3 text-lg"></i> Изтрий акаунта
            </a>
        </div>
    </div>
</div>