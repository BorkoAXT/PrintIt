@page
@model IndexModel
@{
    ViewData["Title"] = "Профил";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="space-y-8">
    @* Заглавна секция в самата карта *@
    <div>
        <h2 class="text-2xl font-bold text-brand-dark">Публична информация</h2>
        <p class="text-slate-500">Това са основните данни за вашия акаунт.</p>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <form id="profile-form" method="post" class="max-w-xl space-y-6">
        <div asp-validation-summary="ModelOnly" class="p-4 rounded-2xl bg-red-50 text-red-600 text-sm" role="alert"></div>

        @* Потребителско име (Read-only) *@
        <div class="space-y-2">
            <label asp-for="Username" class="block text-sm font-semibold text-slate-700">Потребителско име</label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                    <i class="bi bi-person text-slate-400"></i>
                </div>
                <input asp-for="Username" class="block w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 text-slate-500 rounded-2xl sm:text-sm cursor-not-allowed" placeholder="Потребителско име" disabled />
            </div>
        </div>

        @* Телефонен номер *@
        <div class="space-y-2">
            <label asp-for="Input.PhoneNumber" class="block text-sm font-semibold text-slate-700">Телефонен номер</label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                    <i class="bi bi-telephone text-slate-400"></i>
                </div>
                <input asp-for="Input.PhoneNumber" class="block w-full pl-11 pr-4 py-3 bg-white border border-slate-200 text-brand-dark rounded-2xl focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary transition-all sm:text-sm" placeholder="Въведете телефон" />
            </div>
            <span asp-validation-for="Input.PhoneNumber" class="text-xs text-red-500"></span>
        </div>

        @* Бутон за запис *@
        <div class="pt-4">
            <button id="update-profile-button" type="submit" class="w-full sm:w-auto px-8 py-3.5 bg-brand-primary text-white font-bold rounded-2xl hover:bg-brand-dark hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200">
                Запази промените
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}