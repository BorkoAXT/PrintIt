@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Изтриване на профила";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="space-y-8">
    @* Header Section *@
    <div class="flex items-center gap-5 border-b border-slate-100 pb-6">
        <div class="p-3 bg-red-50 rounded-2xl">
            <i class="bi bi-person-x-fill text-red-600 text-2xl"></i>
        </div>
        <div>
            <h3 class="text-2xl font-black text-brand-dark">@ViewData["Title"]</h3>
            <p class="text-slate-500 text-base">Последна стъпка преди окончателното премахване.</p>
        </div>
    </div>

    @* Large Warning Box *@
    <div class="bg-red-50 border-l-4 border-red-500 p-6 rounded-r-[2rem] shadow-sm max-w-2xl">
        <div class="flex items-center gap-4 text-red-800 font-black mb-2">
            <i class="bi bi-exclamation-octagon-fill text-2xl"></i>
            <span class="text-lg">Внимание: Действието е необратимо!</span>
        </div>
        <p class="text-red-700 text-base leading-relaxed ml-10">
            Изтриването на тези данни ще <strong>премахне за постоянно вашия акаунт</strong> и цялата свързана информация. Тези данни не могат да бъдат възстановени по-късно.
        </p>
    </div>

    <div class="max-w-md pt-4">
        <form id="delete-user" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm bg-red-50 p-4 rounded-2xl mb-4 border border-red-100" role="alert"></div>

            @if (Model.RequirePassword)
            {
                <div class="space-y-2">
                    <label asp-for="Input.Password" class="block text-sm font-bold text-slate-700 ml-1">Въведете вашата парола</label>
                    <div class="relative">
                        <input asp-for="Input.Password" 
                               class="w-full px-5 py-4 bg-white border border-slate-200 rounded-2xl focus:ring-4 focus:ring-red-100 focus:border-red-400 outline-none transition-all placeholder:text-slate-300 text-base shadow-sm"
                               autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Input.Password" class="text-red-500 text-sm font-medium mt-2 ml-1 block"></span>
                </div>
            }

            <div class="pt-2">
                <button type="submit" 
                        class="w-full px-8 py-4 bg-red-600 hover:bg-red-700 text-white text-base font-black rounded-2xl shadow-lg shadow-red-200 transition-all active:scale-[0.98]">
                    Изтрий данните и затвори акаунта ми
                </button>
            </div>
            
            <div class="text-center">
                <a asp-page="./PersonalData" class="text-slate-500 hover:text-brand-dark text-sm font-bold transition-colors underline decoration-slate-200 underline-offset-4">
                    Отказ и връщане назад
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}