@page
@model ExternalLoginsModel
@{
    ViewData["Title"] = "Управление на външни входове";
    ViewData["ActivePage"] = ManageNavPages.ExternalLogins;
}

<div class="space-y-8">
    <div class="flex items-center gap-4 border-b border-slate-100 pb-4">
        <div class="p-3 bg-brand-primary/10 rounded-xl">
            <i class="bi bi-person-badge-fill text-brand-primary text-2xl"></i>
        </div>
        <h3 class="text-2xl font-bold text-brand-dark">@ViewData["Title"]</h3>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    @if (Model.CurrentLogins?.Count > 0)
    {
        <div class="space-y-4">
            <h4 class="text-sm font-bold uppercase tracking-widest text-slate-400">Свързани профили</h4>
            <div class="overflow-hidden border border-slate-200 rounded-2xl">
                <table class="w-full text-left bg-white">
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var login in Model.CurrentLogins)
                        {
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-6 py-4 font-bold text-slate-700" id="@($"login-provider-{login.LoginProvider}")">
                                    @login.ProviderDisplayName
                                </td>
                                <td class="px-6 py-4 text-right">
                                    @if (Model.ShowRemoveButton)
                                    {
                                        <form id="@($"remove-login-{login.LoginProvider}")" asp-page-handler="RemoveLogin" method="post">
                                            <div>
                                                <input asp-for="@login.LoginProvider" name="LoginProvider" type="hidden" />
                                                <input asp-for="@login.ProviderKey" name="ProviderKey" type="hidden" />
                                                <button type="submit" class="text-sm font-bold text-red-500 hover:text-red-700 transition-colors"
                                                        title="Премахни този @login.ProviderDisplayName вход от твоя профил">
                                                    Премахни
                                                </button>
                                            </div>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-slate-400 italic">Активен</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (Model.OtherLogins?.Count > 0)
    {
        <div class="pt-6 border-t border-slate-100">
            <h4 class="text-sm font-bold uppercase tracking-widest text-slate-400 mb-4">Добави нов метод за вход</h4>
            <form id="link-login-form" asp-page-handler="LinkLogin" method="post" class="form-horizontal">
                <div id="socialLoginList" class="flex flex-wrap gap-3">
                    @foreach (var provider in Model.OtherLogins)
                    {
                        <button id="@($"link-login-button-{provider.Name}")" type="submit"
                                class="px-6 py-3 bg-white border border-slate-200 rounded-xl font-bold text-slate-700 hover:bg-slate-50 hover:border-brand-primary transition-all shadow-sm flex items-center gap-2"
                                name="provider" value="@provider.Name"
                                title="Влез чрез твоя @provider.DisplayName профил">
                            Влез с @provider.DisplayName
                        </button>
                    }
                </div>
            </form>
        </div>
    }
</div>