@page
@model ExternalLoginsModel
@{
    ViewData["Title"] = "Външни входове";
    ViewData["ActivePage"] = ManageNavPages.ExternalLogins;
}

<div class="space-y-8 transition-colors duration-500">
    @* Header Section *@
    <div class="flex items-center gap-5 border-b border-slate-100 dark:border-slate-800 pb-6">
        <div class="p-3 bg-brand-primary/10 dark:bg-brand-primary/20 rounded-2xl">
            <i class="bi bi-box-arrow-in-right text-brand-primary dark:text-blue-400 text-2xl"></i>
        </div>
        <div>
            <h3 class="text-2xl font-black text-brand-dark dark:text-white">@ViewData["Title"]</h3>
            <p class="text-slate-500 dark:text-slate-400 text-base">Управлявайте свързаните социални мрежи и външни услуги за вход.</p>
        </div>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    @if (Model.CurrentLogins?.Count > 0)
    {
        <div class="space-y-4">
            <h4 class="text-lg font-bold text-slate-700 dark:text-slate-300 ml-1">Регистрирани входове</h4>

            <div class="grid gap-4">
                @foreach (var login in Model.CurrentLogins)
                {
                    <div class="flex items-center justify-between p-5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm hover:border-brand-primary/30 transition-all group">
                        <div class="flex items-center gap-4">
                            @* Dynamic Icon *@
                            <div class="w-10 h-10 flex items-center justify-center rounded-full bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-700 text-brand-dark dark:text-white group-hover:scale-110 transition-transform">
                                @if (login.LoginProvider.ToLower().Contains("google"))
                                {
                                    <i class="bi bi-google"></i>
                                }
                                else if (login.LoginProvider.ToLower().Contains("facebook"))
                                {
                                    <i class="bi bi-facebook"></i>
                                }
                                else
                                {
                                    <i class="bi bi-shield-check"></i>
                                }
                            </div>
                            <div>
                                <span class="font-bold text-brand-dark dark:text-white text-base" id="@($"login-provider-{login.LoginProvider}")">
                                    @login.ProviderDisplayName
                                </span>
                            </div>
                        </div>

                        <div>
                            @if (Model.ShowRemoveButton)
                            {
                                <form id="@($"remove-login-{login.LoginProvider}")" asp-page-handler="RemoveLogin" method="post">
                                    <input asp-for="@login.LoginProvider" name="LoginProvider" type="hidden" />
                                    <input asp-for="@login.ProviderKey" name="ProviderKey" type="hidden" />
                                    <button type="submit" class="px-5 py-2 text-sm font-bold text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-900/20 hover:bg-red-100 dark:hover:bg-red-900/40 rounded-xl transition-all border border-red-100 dark:border-red-900/30"
                                            title="Премахване на @login.ProviderDisplayName вход">
                                        Премахни
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-xs text-slate-400 dark:text-slate-500 italic px-3 py-1 bg-slate-50 dark:bg-slate-800 rounded-lg border border-slate-100 dark:border-slate-700">
                                    Основен вход
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (Model.OtherLogins?.Count > 0)
    {
        <div class="space-y-4 pt-4">
            <div class="border-t border-slate-100 dark:border-slate-800 pt-6">
                <h4 class="text-lg font-bold text-slate-700 dark:text-slate-300 ml-1">Добавяне на нова услуга</h4>
                <p class="text-sm text-slate-500 dark:text-slate-400 ml-1 mb-4">Свържете акаунта си с други платформи за по-лесен достъп.</p>
            </div>

            <form id="link-login-form" asp-page-handler="LinkLogin" method="post" class="flex flex-wrap gap-3">
                @foreach (var provider in Model.OtherLogins)
                {
                    <button id="@($"link-login-button-{provider.Name}")" type="submit" name="provider" value="@provider.Name"
                            class="flex items-center gap-3 px-6 py-3.5 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-brand-dark dark:text-white font-bold rounded-2xl hover:border-brand-primary dark:hover:border-blue-500 hover:bg-brand-primary/5 dark:hover:bg-blue-500/10 hover:shadow-md transition-all active:scale-[0.98]"
                            title="Вход чрез @provider.DisplayName акаунт">
                        @if (provider.Name.ToLower().Contains("google"))
                        {
                            <i class="bi bi-google text-red-500 dark:text-red-400"></i>
                        }
                        else if (provider.Name.ToLower().Contains("facebook"))
                        {
                            <i class="bi bi-facebook text-blue-600 dark:text-blue-400"></i>
                        }
                        @provider.DisplayName
                    </button>
                }
            </form>
        </div>
    }
</div>