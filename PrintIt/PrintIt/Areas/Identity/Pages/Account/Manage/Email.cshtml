@page
@model EmailModel
@{
    ViewData["Title"] = "Имейл адрес";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="space-y-8 transition-colors duration-500">
    @* Header Section *@
    <div class="flex items-center gap-5 border-b border-slate-100 dark:border-slate-800 pb-6">
        <div class="p-3 bg-brand-primary/10 dark:bg-brand-primary/20 rounded-2xl">
            <i class="bi bi-envelope-gear text-brand-primary dark:text-blue-400 text-2xl"></i>
        </div>
        <div>
            <h3 class="text-2xl font-black text-brand-dark dark:text-white">@ViewData["Title"]</h3>
            <p class="text-slate-500 dark:text-slate-400 text-base">Управлявайте вашия имейл за връзка и известия.</p>
        </div>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="max-w-xl">
        <form id="email-form" method="post" class="space-y-7">
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="text-red-600 dark:text-red-400 text-sm bg-red-50 dark:bg-red-900/20 p-4 rounded-2xl mb-6 border border-red-100 dark:border-red-900/30" role="alert"></div>
            }

            @* Current Email Field *@
            <div class="space-y-2">
                <label asp-for="Email" class="block text-sm font-bold text-slate-700 dark:text-slate-300 ml-1">Текущ имейл</label>
                <div class="relative group">
                    <input asp-for="Email"
                           class="w-full px-5 py-4 bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl text-slate-500 dark:text-slate-400 cursor-not-allowed outline-none text-base shadow-inner"
                           disabled />

                    @if (Model.IsEmailConfirmed)
                    {
                        <div class="absolute inset-y-0 right-0 flex items-center pr-4">
                            <span class="flex items-center gap-1.5 px-3 py-1 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 text-xs font-bold uppercase tracking-wider rounded-xl border border-green-200 dark:border-green-800 shadow-sm">
                                <i class="bi bi-patch-check-fill"></i> Потвърден
                            </span>
                        </div>
                    }
                </div>

                @if (!Model.IsEmailConfirmed)
                {
                    <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail"
                            class="ml-1 text-sm font-bold text-brand-primary dark:text-blue-400 hover:text-brand-dark dark:hover:text-white transition-colors underline underline-offset-4 decoration-2">
                        Изпрати имейл за потвърждение
                    </button>
                }
            </div>

            @* New Email Field *@
            <div class="space-y-2 pt-2">
                <label asp-for="Input.NewEmail" class="block text-sm font-bold text-slate-700 dark:text-slate-300 ml-1">Нов имейл адрес</label>
                <div class="relative">
                    <input asp-for="Input.NewEmail"
                           class="w-full px-5 py-4 bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-brand-primary/10 dark:focus:ring-brand-primary/5 focus:border-brand-primary outline-none transition-all placeholder:text-slate-400 dark:placeholder:text-slate-600 text-base shadow-sm dark:text-white"
                           autocomplete="email" aria-required="true" placeholder="Въведете новия имейл" />
                </div>
                <span asp-validation-for="Input.NewEmail" class="text-red-500 dark:text-red-400 text-sm font-medium mt-2 ml-1 block"></span>
            </div>

            @* Submit Button *@
            <div class="pt-4">
                <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail"
                        class="w-full sm:w-auto px-12 py-4 bg-brand-dark dark:bg-brand-primary hover:bg-brand-primary dark:hover:bg-blue-500 text-white text-base font-bold rounded-2xl shadow-lg hover:shadow-brand-primary/30 transition-all active:scale-[0.98]">
                    Запази промените
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}