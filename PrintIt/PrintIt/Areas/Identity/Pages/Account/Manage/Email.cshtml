@page
@model EmailModel
@{
    ViewData["Title"] = "Manage Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="space-y-8">
    <div class="flex items-center gap-4 border-b border-slate-100 pb-4">
        <div class="p-3 bg-brand-primary/10 rounded-xl">
            <i class="bi bi-envelope-gear text-brand-primary text-2xl"></i>
        </div>
        <h3 class="text-2xl font-bold text-brand-dark">@ViewData["Title"]</h3>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="max-w-xl">
        <form id="email-form" method="post" class="space-y-6">
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="text-red-500 text-xs bg-red-50 p-3 rounded-lg mb-4" role="alert"></div>
            }

            <div>
                <label asp-for="Email" class="block text-xs font-bold uppercase tracking-widest text-slate-400 mb-1 ml-1">Current Email</label>
                <div class="relative">
                    <input asp-for="Email"
                           class="w-full px-4 py-3 bg-slate-100 border border-slate-200 rounded-xl text-slate-500 cursor-not-allowed outline-none"
                           disabled />

                    @if (Model.IsEmailConfirmed)
                    {
                        <div class="absolute inset-y-0 right-0 flex items-center pr-4">
                            <span class="flex items-center gap-1.5 px-2.5 py-1 bg-green-100 text-green-700 text-[10px] font-bold uppercase tracking-wider rounded-full border border-green-200">
                                <i class="bi bi-patch-check-fill"></i> Verified
                            </span>
                        </div>
                    }
                </div>

                @if (!Model.IsEmailConfirmed)
                {
                    <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail"
                            class="mt-2 text-sm font-bold text-brand-primary hover:text-brand-dark transition-colors">
                        Send verification email
                    </button>
                }
            </div>

            <div>
                <label asp-for="Input.NewEmail" class="block text-xs font-bold uppercase tracking-widest text-slate-400 mb-1 ml-1">New Email Address</label>
                <input asp-for="Input.NewEmail"
                       class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-none transition-all placeholder:text-slate-400"
                       autocomplete="email" aria-required="true" placeholder="Enter new email address" />
                <span asp-validation-for="Input.NewEmail" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail"
                    class="w-full md:w-auto px-10 py-4 bg-brand-dark hover:bg-brand-primary text-white font-bold rounded-xl shadow-lg hover:shadow-brand-primary/30 transition-all active:scale-[0.98]">
                Update Email
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}