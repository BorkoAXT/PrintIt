@using PrintIt.Models
@inject SignInManager<User> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();

    // Helper function to apply active/inactive styles
    string GetNavLinkClass(string page)
    {
        var activeClass = "bg-brand-primary/10 text-brand-primary font-bold shadow-sm";
        var inactiveClass = "text-slate-600 hover:bg-slate-50 hover:text-brand-dark";
        var baseClass = "flex items-center gap-3 px-5 py-3.5 rounded-2xl transition-all duration-200 group";

        var currentClass = ManageNavPages.PageNavClass(ViewContext, page) == "active" ? activeClass : inactiveClass;
        return $"{baseClass} {currentClass}";
    }
}

<ul class="flex flex-col gap-2 list-none p-0 m-0">
    <li class="nav-item">
        <a class="@GetNavLinkClass(ManageNavPages.Index)" id="profile" asp-page="./Index">
            <i class="bi bi-person-circle text-xl"></i>
            <span>Профил</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="@GetNavLinkClass(ManageNavPages.Email)" id="email" asp-page="./Email">
            <i class="bi bi-envelope-at text-xl"></i>
            <span>Имейл</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="@GetNavLinkClass(ManageNavPages.ChangePassword)" id="change-password" asp-page="./ChangePassword">
            <i class="bi bi-shield-lock text-xl"></i>
            <span>Парола</span>
        </a>
    </li>
    @if (hasExternalLogins)
    {
        <li id="external-logins" class="nav-item">
            <a id="external-login" class="@GetNavLinkClass(ManageNavPages.ExternalLogins)" asp-page="./ExternalLogins">
                <i class="bi bi-box-arrow-in-right text-xl"></i>
                <span>Външни входове</span>
            </a>
        </li>
    }
    <li class="nav-item">
        <a class="@GetNavLinkClass(ManageNavPages.TwoFactorAuthentication)" id="two-factor" asp-page="./TwoFactorAuthentication">
            <i class="bi bi-safe2 text-xl"></i>
            <span>Двуфакторна защита</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="@GetNavLinkClass(ManageNavPages.PersonalData)" id="personal-data" asp-page="./PersonalData">
            <i class="bi bi-database-lock text-xl"></i>
            <span>Лични данни</span>
        </a>
    </li>
</ul>