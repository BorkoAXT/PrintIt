@{
    // Inherit from the main site layout
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="max-w-6xl mx-auto px-4 pt-4 pb-12">
    <div class="mb-8">
        <h1 class="text-4xl font-black text-brand-dark tracking-tight">Настройки на профила</h1>
        <p class="text-slate-500 mt-2 text-base">Управлявайте вашия профил и сигурност.</p>
    </div>

    <div class="flex flex-col lg:flex-row gap-8">

        <aside class="w-full lg:w-72 shrink-0">
            <div class="bg-white border border-slate-200 rounded-[2rem] p-5 shadow-sm sticky top-20">
                <nav>
                    <partial name="_ManageNav" />
                </nav>
            </div>
        </aside>

        <main class="flex-grow">
            <div class="bg-white border border-slate-200 rounded-[2rem] p-6 md:p-8 shadow-sm transition-all">
                @RenderBody()
            </div>
        </main>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}