@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Задаване на парола";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="space-y-8">
    <div class="flex items-center gap-4 border-b border-slate-100 pb-4">
        <div class="p-3 bg-brand-primary/10 rounded-xl">
            <i class="bi bi-key-fill text-brand-primary text-2xl"></i>
        </div>
        <h3 class="text-2xl font-bold text-brand-dark">Задайте вашата парола</h3>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="bg-blue-50 border border-blue-100 rounded-2xl p-5 flex gap-4">
        <i class="bi bi-info-circle-fill text-blue-500 text-xl shrink-0"></i>
        <p class="text-sm text-blue-800 leading-relaxed">
            Все още нямате локална парола за този сайт.
            <strong>Добавете локален профил</strong>, за да можете да влизате директно, без да е необходимо използването на външна услуга.
        </p>
    </div>

    <div class="max-w-xl">
        <form id="set-password-form" method="post" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-xs bg-red-50 p-3 rounded-lg mb-4" role="alert"></div>

            <div>
                <label asp-for="Input.NewPassword" class="block text-xs font-bold uppercase tracking-widest text-slate-400 mb-1 ml-1">Нова парола</label>
                <input asp-for="Input.NewPassword"
                       class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-none transition-all placeholder:text-slate-400"
                       autocomplete="new-password" placeholder="Минимум 6 символа" />
                <span asp-validation-for="Input.NewPassword" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Input.ConfirmPassword" class="block text-xs font-bold uppercase tracking-widest text-slate-400 mb-1 ml-1">Потвърдете новата парола</label>
                <input asp-for="Input.ConfirmPassword"
                       class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-none transition-all placeholder:text-slate-400"
                       autocomplete="new-password" placeholder="Повторете паролата" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <button type="submit"
                    class="w-full md:w-auto px-10 py-4 bg-brand-dark hover:bg-brand-primary text-white font-bold rounded-xl shadow-lg hover:shadow-brand-primary/30 transition-all active:scale-[0.98]">
                Задай парола
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}