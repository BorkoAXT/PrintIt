@page
@model LoginModel

<div class="auth-page-wrapper">
    <div class="auth-card-modern">
        <h1 class="auth-title">Welcome</h1>
        <p class="text-center text-muted mb-4">Please sign in to your account</p>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <input asp-for="Input.Email" class="input-modern" placeholder="Email Address" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <input asp-for="Input.Password" class="input-modern" placeholder="Password" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between mb-4 px-1">
                <div class="form-check">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label small" style="color: var(--medium-blue)">Stay logged in</label>
                </div>
                <a asp-page="./ForgotPassword" class="small text-decoration-none" style="color: var(--light-blue); font-weight: 600;">Forgot?</a>
            </div>

            <button type="submit" class="btn-primary-modern">Sign In</button>
        </form>

        <div class="divider-text">Social Login</div>

        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            @foreach (var provider in Model.ExternalLogins ?? new List<Microsoft.AspNetCore.Authentication.AuthenticationScheme>())
            {
                <button type="submit" class="btn-social" name="provider" value="@provider.Name">
                    Login with @provider.DisplayName
                </button>
            }
        </form>

        <p class="text-center small mt-4">
            New user? <a asp-page="./Register" style="color: var(--green); font-weight: 700; text-decoration: none;">Create an account</a>
        </p>
    </div>
</div>