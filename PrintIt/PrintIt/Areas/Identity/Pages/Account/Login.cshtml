@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="flex flex-col items-center justify-center py-10 min-h-[80vh] transition-colors duration-500">
    <div class="w-full max-w-md bg-white dark:bg-slate-900 rounded-[2.5rem] shadow-2xl shadow-slate-200/50 dark:shadow-none border border-slate-100 dark:border-slate-800 p-8 md:p-12 transition-colors">

        @* Branding/Header *@
        <div class="text-center mb-10">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-blue-600 dark:bg-blue-500 rounded-2xl mb-6 shadow-lg shadow-blue-200 dark:shadow-none">
                <i class="bi bi-person-lock text-white text-3xl"></i>
            </div>
            <h1 class="text-3xl font-black text-slate-900 dark:text-white tracking-tight">Добре дошли</h1>
            <p class="text-slate-500 dark:text-slate-400 mt-2 font-medium">Влезте във вашия 3D Lab профил</p>
        </div>

        <form id="account" method="post" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-xs bg-red-50 dark:bg-red-900/20 p-4 rounded-xl mb-4 border border-red-100 dark:border-red-900/30" role="alert"></div>

            @* Email Field *@
            <div class="space-y-1.5">
                <label asp-for="Input.Email" class="block text-xs font-black uppercase tracking-widest text-slate-400 dark:text-slate-500 ml-1">Имейл</label>
                <input asp-for="Input.Email"
                       class="w-full px-5 py-4 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-2xl focus:ring-4 focus:ring-blue-500/10 focus:border-blue-600 dark:focus:border-blue-500 outline-none transition-all placeholder:text-slate-300 dark:placeholder:text-slate-600 text-slate-900 dark:text-white"
                       autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="text-red-500 text-xs mt-1 ml-1 block font-medium"></span>
            </div>

            @* Password Field *@
            <div class="space-y-1.5">
                <label asp-for="Input.Password" class="block text-xs font-black uppercase tracking-widest text-slate-400 dark:text-slate-500 ml-1">Парола</label>
                <input asp-for="Input.Password"
                       class="w-full px-5 py-4 bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 rounded-2xl focus:ring-4 focus:ring-blue-500/10 focus:border-blue-600 dark:focus:border-blue-500 outline-none transition-all placeholder:text-slate-300 dark:placeholder:text-slate-600 text-slate-900 dark:text-white"
                       autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-red-500 text-xs mt-1 ml-1 block font-medium"></span>
            </div>

            @* Remember Me & Forgot Password *@
            <div class="flex items-center justify-between px-1">
                <div class="flex items-center group cursor-pointer">
                    <input asp-for="Input.RememberMe"
                           class="w-5 h-5 text-blue-600 border-slate-300 dark:border-slate-700 rounded-lg focus:ring-blue-500/20 bg-white dark:bg-slate-800" />
                    <label asp-for="Input.RememberMe" class="ml-3 text-sm font-bold text-slate-600 dark:text-slate-400 cursor-pointer group-hover:text-blue-600 transition-colors">
                        Запомни ме
                    </label>
                </div>
                <a asp-page="./ForgotPassword" class="text-sm font-black text-blue-600 dark:text-blue-400 hover:text-blue-700 transition-colors">
                    Забравена парола?
                </a>
            </div>

            <button id="login-submit" type="submit"
                    class="w-full py-5 bg-slate-900 dark:bg-blue-600 hover:bg-blue-600 dark:hover:bg-blue-500 text-white font-black rounded-2xl shadow-xl shadow-blue-900/10 transition-all active:scale-[0.98] mt-4">
                Вход в системата
            </button>
        </form>

        @* Social Login Divider *@
        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="relative my-10">
                <div class="absolute inset-0 flex items-center">
                    <span class="w-full border-t border-slate-100 dark:border-slate-800"></span>
                </div>
                <div class="relative flex justify-center text-xs uppercase">
                    <span class="bg-white dark:bg-slate-900 px-4 text-slate-400 dark:text-slate-500 font-black tracking-[0.2em]">Социални мрежи</span>
                </div>
            </div>

            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div class="grid grid-cols-1 gap-4">
                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        <button type="submit" name="provider" value="@provider.Name"
                                class="flex items-center justify-center gap-3 px-5 py-4 border border-slate-200 dark:border-slate-700 rounded-2xl hover:bg-slate-50 dark:hover:bg-slate-800 font-bold text-slate-700 dark:text-slate-300 transition-all active:scale-95">
                            @if (provider.DisplayName == "Google")
                            {
                                <i class="bi bi-google text-blue-500"></i>
                            }
                            else if (provider.DisplayName == "Facebook")
                            {
                                <i class="bi bi-facebook text-blue-600"></i>
                            }
                            <span>Вход с @provider.DisplayName</span>
                        </button>
                    }
                </div>
            </form>
        }

        @* Footer Link *@
        <p class="text-center text-slate-500 dark:text-slate-500 text-sm mt-10">
            Нямате профил?
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-blue-600 dark:text-blue-400 font-black hover:underline ml-1">Създайте го тук</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}