@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Нулиране на парола";
}

<div class="flex flex-col items-center justify-center py-10">
    <div class="w-full max-w-md bg-white rounded-3xl shadow-xl border border-slate-200 p-8 md:p-10">

        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-brand-primary/10 rounded-full mb-4">
                <i class="bi bi-shield-lock text-brand-primary text-3xl"></i>
            </div>
            <h1 class="text-3xl font-extrabold text-brand-dark tracking-tight">@ViewData["Title"]</h1>
            <p class="text-slate-500 mt-2">Създайте нова сигурна парола за вашия акаунт</p>
        </div>

        <form method="post" class="space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-xs bg-red-50 p-3 rounded-lg mb-4" role="alert"></div>

            <input asp-for="Input.Code" type="hidden" />

            <div>
                <label asp-for="Input.Email" class="block text-xs font-bold uppercase tracking-widest text-slate-400 mb-1 ml-1">Имейл на акаунта</label>
                <input asp-for="Input.Email"
                       class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-none transition-all placeholder:text-slate-400"
                       autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Input.Password" class="block text-xs font-bold uppercase tracking-widest text-slate-400 mb-1 ml-1">Нова парола</label>
                <input asp-for="Input.Password"
                       class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-none transition-all placeholder:text-slate-400"
                       autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Input.ConfirmPassword" class="block text-xs font-bold uppercase tracking-widest text-slate-400 mb-1 ml-1">Потвърдете новата парола</label>
                <input asp-for="Input.ConfirmPassword"
                       class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-none transition-all placeholder:text-slate-400"
                       autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <button type="submit"
                    class="w-full py-4 bg-brand-dark hover:bg-brand-primary text-white font-bold rounded-xl shadow-lg hover:shadow-brand-primary/30 transition-all active:scale-[0.98] mt-4">
                Нулирай паролата
            </button>
        </form>

        <div class="text-center mt-8">
            <a asp-page="./Login" class="text-sm font-bold text-slate-500 hover:text-brand-primary transition-colors flex items-center justify-center gap-2">
                <i class="bi bi-arrow-left"></i>
                Обратно към влизане
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}