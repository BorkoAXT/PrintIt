@page
@model RegisterModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="flex flex-col items-center justify-center py-10">
    <div class="w-full max-w-md bg-white rounded-3xl shadow-xl border border-slate-200 p-8 md:p-10">

        <div class="text-center mb-8">
            <h1 class="text-3xl font-extrabold text-brand-dark tracking-tight">Get Started</h1>
            <p class="text-slate-500 mt-2">Join PrintIt 3D and start creating today</p>
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-xs bg-red-50 p-3 rounded-lg mb-4" role="alert"></div>

            <div>
                <label asp-for="Input.Email" class="block text-xs font-bold uppercase tracking-widest text-slate-400 mb-1 ml-1"></label>
                <input asp-for="Input.Email"
                       class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-none transition-all placeholder:text-slate-400"
                       autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Input.Password" class="block text-xs font-bold uppercase tracking-widest text-slate-400 mb-1 ml-1"></label>
                <input asp-for="Input.Password"
                       class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-none transition-all placeholder:text-slate-400"
                       autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Input.ConfirmPassword" class="block text-xs font-bold uppercase tracking-widest text-slate-400 mb-1 ml-1"></label>
                <input asp-for="Input.ConfirmPassword"
                       class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-none transition-all placeholder:text-slate-400"
                       autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <button id="registerSubmit" type="submit"
                    class="w-full py-4 bg-brand-dark hover:bg-brand-primary text-white font-bold rounded-xl shadow-lg hover:shadow-brand-primary/30 transition-all active:scale-[0.98] mt-4">
                Create Account
            </button>
        </form>

        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="relative my-8">
                <div class="absolute inset-0 flex items-center"><span class="w-full border-t border-slate-200"></span></div>
                <div class="relative flex justify-center text-xs uppercase"><span class="bg-white px-4 text-slate-400 font-semibold tracking-widest">Or join with</span></div>
            </div>

            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div class="grid grid-cols-1 gap-3">
                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        <button type="submit" name="provider" value="@provider.Name"
                                class="flex items-center justify-center gap-3 px-4 py-3 border border-slate-200 rounded-xl hover:bg-slate-50 font-semibold text-slate-700 transition-colors">
                            @if (provider.DisplayName == "Google")
                            {
                                <i class="bi bi-google text-blue-500"></i>
                            }
                            else if (provider.DisplayName == "Facebook")
                            {

                                <i class="bi bi-facebook text-blue-600"></i>
                            }
                            <span>@provider.DisplayName</span>
                        </button>
                    }
                </div>
            </form>
        }

        <p class="text-center text-slate-500 text-sm mt-8">
            Already have an account?
            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-brand-primary font-bold hover:underline">Sign in</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}