@page
@model RegisterModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="auth-page-wrapper">
    <div class="auth-card-modern">
        <h1 class="auth-title">Get Started</h1>
        <p class="auth-subtitle">Join us and start your journey today</p>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

            <div class="mb-3">
                <input asp-for="Input.Email" class="input-modern" autocomplete="username" aria-required="true" placeholder="Email Address" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <input asp-for="Input.Password" class="input-modern" autocomplete="new-password" aria-required="true" placeholder="Password" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <input asp-for="Input.ConfirmPassword" class="input-modern" autocomplete="new-password" aria-required="true" placeholder="Confirm Password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <button id="registerSubmit" type="submit" class="btn-primary-modern">Create Account</button>
        </form>

        <div class="divider-text">Or join with</div>

        @{
            if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        <button type="submit" class="btn-social" name="provider" value="@provider.Name">
                            Sign up with @provider.DisplayName
                        </button>
                    }
                </form>
            }
        }

        <p class="text-center small mt-4">
            Already have an account?
            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="auth-footer-link">Sign in</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}