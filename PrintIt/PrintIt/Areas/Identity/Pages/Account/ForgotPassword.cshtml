@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<div class="flex flex-col items-center justify-center py-10">
    <div class="w-full max-w-md bg-white rounded-3xl shadow-xl border border-slate-200 p-8 md:p-10">

        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-brand-primary/10 rounded-full mb-4">
                <i class="bi bi-envelope-at text-brand-primary text-3xl"></i>
            </div>
            <h1 class="text-3xl font-extrabold text-brand-dark tracking-tight">Recover Access</h1>
            <p class="text-slate-500 mt-2">Enter your email and we'll send you a link to reset your password.</p>
        </div>

        <form method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-xs bg-red-50 p-3 rounded-lg" role="alert"></div>

            <div>
                <label asp-for="Input.Email" class="block text-xs font-bold uppercase tracking-widest text-slate-400 mb-1 ml-1">Registered Email</label>
                <input asp-for="Input.Email"
                       class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-brand-primary/20 focus:border-brand-primary outline-none transition-all placeholder:text-slate-400"
                       autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <button type="submit"
                    class="w-full py-4 bg-brand-dark hover:bg-brand-primary text-white font-bold rounded-xl shadow-lg hover:shadow-brand-primary/30 transition-all active:scale-[0.98]">
                Send Reset Link
            </button>
        </form>

        <div class="text-center mt-8">
            <a asp-page="./Login" class="text-sm font-bold text-slate-500 hover:text-brand-primary transition-colors flex items-center justify-center gap-2">
                <i class="bi bi-arrow-left"></i>
                Back to Sign In
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}