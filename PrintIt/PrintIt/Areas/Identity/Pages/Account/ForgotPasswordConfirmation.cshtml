@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Потвърждение за възстановяване";
}

<div class="flex flex-col items-center justify-center py-10">
    <div class="w-full max-w-md bg-white rounded-3xl shadow-xl border border-slate-200 p-8 md:p-10 text-center">

        @* Success Icon *@
        <div class="inline-flex items-center justify-center w-20 h-20 bg-green-50 rounded-full mb-6">
            <i class="bi bi-envelope-check text-green-600 text-4xl"></i>
        </div>

        @* Content *@
        <h1 class="text-3xl font-extrabold text-brand-dark tracking-tight mb-4">Проверете имейла си</h1>

        <div class="space-y-4">
            <p class="text-slate-600 text-base leading-relaxed">
                Изпратихме инструкции за възстановяване на паролата на вашия имейл адрес. Моля, проверете пощата си и последвайте линка.
            </p>

            <div class="bg-blue-50 border border-blue-100 rounded-2xl p-4 text-sm text-blue-700">
                <p>
                    <strong>Не виждате имейла?</strong> Проверете папката "Спам" или изчакайте няколко минути.
                </p>
            </div>
        </div>

        @* Actions *@
        <div class="mt-8 pt-6 border-t border-slate-50 space-y-4">
            <a asp-page="./Login" class="block w-full py-4 bg-brand-dark hover:bg-brand-primary text-white font-bold rounded-xl shadow-lg transition-all active:scale-[0.98]">
                Към страницата за вход
            </a>

            <a href="/" class="block text-sm font-bold text-slate-500 hover:text-brand-primary transition-colors">
                Обратно към началната страница
            </a>
        </div>
    </div>
</div>