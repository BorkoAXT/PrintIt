@using PrintIt.Models
@{
    ViewData["Title"] = "Количка";
    var cartItems = ViewData["CartItems"] as List<CartItem> ?? new List<CartItem>();
    decimal subtotal = cartItems.Sum(item => (item.Print?.Price ?? 0) * item.Quantity);
    decimal shipping = subtotal > 100 || subtotal == 0 ? 0 : 5.00m; // Delivery is free for orders over 100
    decimal total = subtotal + shipping;
}

<div class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex items-center gap-4 mb-10">
        <div class="h-12 w-12 bg-brand-primary rounded-2xl flex items-center justify-center shadow-lg shadow-brand-primary/20">
            <i class="bi bi-cart-fill text-white text-2xl"></i>
        </div>
        <h1 class="text-4xl font-black text-brand-dark tracking-tight">Твоята количка</h1>
    </div>

    @if (cartItems.Any())
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">

            <div class="lg:col-span-2 space-y-6">
                @foreach (var item in cartItems)
                {
                    <div class="group bg-white rounded-3xl p-6 border border-slate-100 shadow-sm hover:shadow-md transition-all flex flex-col sm:flex-row items-center gap-6">

                        <div class="h-32 w-32 shrink-0 overflow-hidden rounded-2xl bg-slate-50 border border-slate-100">
                            <img src="@(string.IsNullOrEmpty(item.Print?.FilePath) ? "/images/placeholder.jpg" : item.Print.FilePath)"
                                 class="h-full w-full object-cover group-hover:scale-110 transition-transform duration-500" />
                        </div>

                        <div class="flex-grow text-center sm:text-left">
                            <h3 class="text-xl font-bold text-brand-dark">@item.Print?.Name</h3>
                            <p class="text-slate-400 text-sm mb-2 uppercase font-bold tracking-tighter">
                                <i class="bi bi-cpu"></i> 3D Принт • @item.Print?.MaterialType
                            </p>
                            <div class="flex items-center justify-center sm:justify-start gap-4">
                                <span class="text-lg font-black text-brand-primary">@item.Print?.Price.ToString("0.00") лв.</span>
                                <span class="text-slate-300">|</span>
                                <span class="text-slate-500 font-medium">Количество: @item.Quantity</span>
                            </div>
                        </div>

                        <div class="flex sm:flex-col items-center gap-2">
                            <button class="p-3 text-slate-400 hover:text-red-500 hover:bg-red-50 rounded-xl transition-colors" title="Премахни">
                                <i class="bi bi-trash3-fill text-xl"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>

            <div class="lg:col-span-1">
                <div class="bg-brand-dark rounded-[2.5rem] p-8 text-white shadow-2xl sticky top-8">
                    <h2 class="text-2xl font-bold mb-8 flex items-center gap-2">
                        <i class="bi bi-receipt"></i> Резюме
                    </h2>

                    <div class="space-y-4 mb-8">
                        <div class="flex justify-between text-slate-400 font-medium">
                            <span>Междинна сума:</span>
                            <span class="text-white">@subtotal.ToString("0.00") лв.</span>
                        </div>
                        <div class="flex justify-between text-slate-400 font-medium">
                            <span>Доставка:</span>
                            @if (shipping == 0 && subtotal > 0)
                            {
                                <span class="text-green-400 uppercase text-xs font-bold bg-green-400/10 px-2 py-1 rounded">Безплатна</span>
                            }
                            else
                            {
                                <span class="text-white">@shipping.ToString("0.00") лв.</span>
                            }
                        </div>
                        <div class="pt-4 border-t border-white/10 flex justify-between items-end">
                            <span class="text-lg">Общо:</span>
                            <span class="text-3xl font-black text-brand-primary">@total.ToString("0.00") лв.</span>
                        </div>
                    </div>

                    <button class="w-full bg-brand-primary hover:bg-blue-500 text-white py-5 rounded-2xl font-bold text-lg shadow-lg shadow-brand-primary/20 transition-all active:scale-95 flex items-center justify-center gap-3">
                        Завърши поръчката
                        <i class="bi bi-arrow-right"></i>
                    </button>

                    @if (subtotal < 100 && subtotal > 0)
                    {
                        <p class="mt-6 text-xs text-center text-slate-400 italic">
                            Добави още <b>@((100 - subtotal).ToString("0.00")) лв.</b> за безплатна доставка!
                        </p>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="bg-brand-soft/30 backdrop-blur-sm rounded-[3rem] border-2 border-dashed border-slate-200/60 py-24 text-center">
            <div class="w-24 h-24 bg-white rounded-full flex items-center justify-center shadow-sm mx-auto mb-6">
                <i class="bi bi-cart-x text-slate-300 text-4xl"></i>
            </div>
            <h2 class="text-2xl font-black text-brand-dark mb-2">Количката ти е празна</h2>
            <p class="text-slate-500 mb-10 max-w-sm mx-auto">Изглежда още не си избрал нищо. Разгледай нашите уникални 3D модели и напълни количката!</p>
            <a asp-controller="Store" asp-action="Articles"
               class="inline-flex items-center gap-2 bg-brand-primary text-white px-10 py-4 rounded-2xl font-bold hover:scale-105 transition-transform shadow-xl shadow-brand-primary/20">
                Към магазина
                <i class="bi bi-shop"></i>
            </a>
        </div>
    }
</div>

@section Scripts {
    <style>
        .bg-brand-dark {
            background: linear-gradient(145deg, #0f172a 0%, #1e293b 100%);
        }
    </style>
}