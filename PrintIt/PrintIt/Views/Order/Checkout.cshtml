@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Завършване на поръчката";
    // Total amount passed from the Cart controller
    var totalAmount = ViewBag.TotalAmount ?? 0;
}

<div class="max-w-2xl mx-auto px-4 py-16">
    <div class="bg-white rounded-[2.5rem] p-8 shadow-2xl border border-slate-100">
        <div class="flex items-center gap-4 mb-8">
            <div class="h-12 w-12 bg-brand-primary rounded-2xl flex items-center justify-center">
                <i class="bi bi-shield-check text-white text-2xl"></i>
            </div>
            <div>
                <h1 class="text-3xl font-black text-brand-dark">Сигурно плащане</h1>
                <p class="text-slate-500">Обща сума за плащане: <span class="font-bold text-brand-primary">€@totalAmount.ToString("F2")</span></p>
            </div>
        </div>

        <form id="payment-form">
            <div id="payment-element" class="mb-6">
            </div>

            <button id="submit-button" class="w-full bg-brand-dark hover:bg-brand-primary text-white py-4 rounded-2xl font-bold text-lg shadow-xl transition-all active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-3">
                <span id="button-text">Плати сега</span>
                <div id="spinner" class="hidden animate-spin h-5 w-5 border-2 border-white border-t-transparent rounded-full"></div>
            </button>

            <div id="payment-message" class="hidden mt-4 p-4 rounded-xl bg-red-50 text-red-600 text-sm text-center font-medium"></div>
        </form>

        <div class="mt-8 flex items-center justify-center gap-6 opacity-50">
            <i class="bi bi-stripe text-3xl"></i>
            <i class="bi bi-credit-card-2-back text-2xl"></i>
            <i class="bi bi-lock-fill text-xl"></i>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://js.stripe.com/v3/"></script>

    <script>
        // Use your Publishable Key from appsettings.json
        const stripe = Stripe('@Configuration["Stripe:PublishableKey"]');

        let elements;

        // Start the process immediately on page load
        initialize();

        async function initialize() {
            try {
                // 2. Request the Client Secret from your Controller
                const response = await fetch(`/Order/CreatePaymentIntent?amount=@totalAmount`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" }
                });

                const { clientSecret, error } = await response.json();

                if (error) {
                    showMessage(error);
                    return;
                }

                // 3. Mount the Payment Element
                elements = stripe.elements({ clientSecret, appearance: { theme: 'stripe' } });
                const paymentElement = elements.create("payment");
                paymentElement.mount("#payment-element");

            } catch (e) {
                console.error("Initialization error:", e);
                showMessage("Възникна грешка при свързване със Stripe.");
            }
        }

        document.querySelector("#payment-form").addEventListener("submit", handleSubmit);

        async function handleSubmit(e) {
            e.preventDefault();
            setLoading(true);

            // 4. Confirm the payment with Stripe
            const { error } = await stripe.confirmPayment({
                elements,
                confirmParams: {
                    // Redirect to your Success action after payment
                    return_url: window.location.origin + "/Order/Success",
                },
            });

            // This only runs if there's an immediate error (like card rejection)
            if (error.type === "card_error" || error.type === "validation_error") {
                showMessage(error.message);
            } else {
                showMessage("Възникна неочаквана грешка.");
            }

            setLoading(false);
        }

        // --- Helper Functions ---

        function showMessage(messageText) {
            const messageContainer = document.querySelector("#payment-message");
            messageContainer.classList.remove("hidden");
            messageContainer.textContent = messageText;

            setTimeout(function () {
                messageContainer.classList.add("hidden");
                messageText.textContent = "";
            }, 4000);
        }

        function setLoading(isLoading) {
            const submitBtn = document.querySelector("#submit-button");
            const spinner = document.querySelector("#spinner");
            const btnText = document.querySelector("#button-text");

            submitBtn.disabled = isLoading;
            if (isLoading) {
                spinner.classList.remove("hidden");
                btnText.classList.add("hidden");
            } else {
                spinner.classList.add("hidden");
                btnText.classList.remove("hidden");
            }
        }
    </script>
}