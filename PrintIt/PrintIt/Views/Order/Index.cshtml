@{
    ViewData["Title"] = "Индивидуална поръчка";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-[80vh] flex items-center justify-center bg-slate-50 px-4">
    <div class="max-w-3xl w-full">
        @* Main Card *@
        <div class="relative bg-white rounded-[3rem] shadow-2xl shadow-blue-100/50 border border-slate-100 overflow-hidden p-12 md:p-20 text-center">

            @* Decorative Blobs *@
            <div class="absolute -top-24 -right-24 w-64 h-64 bg-blue-50 rounded-full blur-3xl opacity-60"></div>
            <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-indigo-50 rounded-full blur-3xl opacity-60"></div>

            @* Icon with animation *@
            <div class="relative mb-10 inline-flex items-center justify-center">
                <div class="absolute inset-0 bg-blue-100 rounded-3xl rotate-6 scale-110 opacity-30"></div>
                <div class="relative bg-gradient-to-br from-blue-600 to-indigo-700 p-6 rounded-3xl shadow-xl shadow-blue-200">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-14 w-14 text-white animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z" />
                    </svg>
                </div>
            </div>

            @* Text part *@
            <div class="relative">
                <h2 class="text-sm font-black uppercase tracking-[0.4em] text-blue-500 mb-6">Coming Soon</h2>

                <h1 class="text-5xl md:text-7xl font-black text-slate-900 mb-8 tracking-tight leading-none">
                    Вашият проект, <br />
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">нашата реализация.</span>
                </h1>

                <div class="w-20 h-1.5 bg-gradient-to-r from-blue-600 to-indigo-600 mx-auto rounded-full mb-8"></div>

                <p class="text-xl text-slate-500 max-w-lg mx-auto leading-relaxed font-medium">
                    Работим върху нова система за персонализирани 3D поръчки. Очаквайте скоро възможност за качване на ваши модели и дизайн.
                </p>
            </div>

            @* Subtle Status Tag *@
            <div class="mt-12 inline-flex items-center gap-2 px-4 py-2 bg-slate-50 rounded-full border border-slate-100">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
                </span>
                <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">В процес на изграждане</span>
            </div>
        </div>

        @* Back link *@
        <div class="mt-10 text-center">
            <a asp-controller="Store" asp-action="Articles" class="text-slate-400 hover:text-blue-600 font-bold text-sm uppercase tracking-[0.2em] transition-all flex items-center justify-center gap-3 group">
                <i class="bi bi-chevron-left transition-transform group-hover:-translate-x-1"></i>
                Разгледайте магазина
            </a>
        </div>
    </div>
</div>