@using PrintIt.Models
@{
    ViewData["Title"] = "Артикули";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var items = ViewData["Items"] as List<Print>;
}

<div class="border-b border-slate-100 pb-6 mb-8">
    <h1 class="text-5xl font-extrabold text-brand-dark tracking-tight">Артикули</h1>
    <p class="text-slate-500 mt-2 text-lg">Browse our high-quality 3D printed collection.</p>
</div>

<div class="relative group">
    <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold tracking-tight text-slate-400 uppercase tracking-widest">Фигурки</h2>

        @if (items != null && items.Count > 4)
        {
            <div class="flex gap-2">
                <button onclick="scrollGrid('print-grid', -1)" class="p-2 rounded-full border border-slate-200 bg-white hover:bg-slate-50 text-slate-600 transition-colors shadow-sm">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <button onclick="scrollGrid('print-grid', 1)" class="p-2 rounded-full border border-slate-200 bg-white hover:bg-slate-50 text-slate-600 transition-colors shadow-sm">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        }
    </div>

    @if (items == null || items.Count == 0)
    {
        <div class="flex flex-col items-center justify-center py-20 bg-slate-50 rounded-3xl border-2 border-dashed border-slate-200 text-center">
            <div class="w-20 h-20 bg-slate-100 rounded-full flex items-center justify-center mb-4">
                <i class="bi bi-box-seam text-slate-400 text-3xl"></i>
            </div>
            <h3 class="text-xl font-bold text-slate-600">Няма налични фигурки в момента.</h3>
        </div>
    }
    else
    {
        <div id="print-grid" class="flex overflow-x-auto scrollbar-hide snap-x snap-mandatory gap-8 pb-4 scroll-smooth">
            @foreach (var item in items)
            {
                <div class="snap-start shrink-0 w-full sm:w-[calc(50%-1rem)] lg:w-[calc(25%-1.5rem)] group relative flex flex-col">
                    <div class="aspect-square w-full overflow-hidden rounded-2xl bg-slate-100 border border-slate-200 transition-all group-hover:shadow-xl group-hover:shadow-brand-primary/10 group-hover:-translate-y-1">

                        @{
                            // Construct the path: /images/Figures/filename.jpg
                            // If FilePath is empty, use a placeholder
                            var imagePath = !string.IsNullOrEmpty(item.FilePath)
                            ? $"{item.FilePath}"
                            : "/images/placeholder-figure.jpg";
                        }

                        <img src="@imagePath"
                             alt="@item.Name"
                             class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-110" />

                        <div class="absolute inset-0 bg-brand-dark/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                            <a asp-action="Details" asp-route-id="@item.Id" class="bg-white text-brand-dark px-4 py-2 rounded-lg font-bold text-sm shadow-xl transform translate-y-4 group-hover:translate-y-0 transition-transform">
                                Виж детайли
                            </a>
                        </div>
                    </div>
                </div>

                <div class="group relative">
                    <img src="https://tailwindcss.com/plus-assets/img/ecommerce-images/product-page-01-related-product-04.jpg" alt="Front of men&#039;s Artwork Tee in peach." class="aspect-square w-full rounded-md bg-gray-200 object-cover group-hover:opacity-75 lg:aspect-auto lg:h-80" />
                    <div class="mt-4 flex justify-between">
                        <div>
                            <h3 class="text-base font-bold text-brand-dark">
                                <a asp-action="Details" asp-route-id="@item.Id">@item.Name</a>
                            </h3>
                            <p class="mt-1 text-xs font-medium text-slate-400 uppercase tracking-tighter">
                                <i class="bi bi-cpu text-brand-primary"></i> 3D Printed Figure
                            </p>
                        </div>
                        <p class="text-lg font-black text-brand-primary">@item.Price.ToString("0.00") лв.</p>
                    </div>

                    <button class="mt-3 w-full py-2 bg-slate-50 hover:bg-brand-primary hover:text-white border border-slate-200 text-slate-600 font-bold rounded-xl transition-all text-sm z-10">
                        Добави в количката
                    </button>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        function scrollGrid(id, direction) {
            const grid = document.getElementById(id);
            const scrollAmount = grid.clientWidth;
            grid.scrollBy({ left: scrollAmount * direction, behavior: 'smooth' });
        }
    </script>
}
    </div>
</main>

@if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
{
	<div class="fixed bottom-10 right-10 z-[100]">
		<a asp-controller="AddPrint" asp-action="CreateMenu" 
		   title="Add New Print"
		   class="group flex h-16 w-16 items-center justify-center rounded-full shadow-2xl transition-all duration-300 hover:scale-110 active:scale-95 border-2 border-[#1861ac]"
		   style="background-color: #1b6ec2;">
            
			@* SVG Plus Icon *@
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="white" class="h-8 w-8 transition-transform duration-500 group-hover:rotate-180">
				<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
			</svg>

			@* Tooltip Label *@
			<span class="absolute right-20 scale-0 transition-all duration-200 rounded bg-gray-900 px-3 py-1 text-sm font-medium text-white group-hover:scale-100 whitespace-nowrap shadow-lg">
				Add New Print
			</span>
		</a>
	</div>
}
