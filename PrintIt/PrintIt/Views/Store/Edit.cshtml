@model PrintIt.ViewModels.PrintsViewModel
@using PrintIt.Enums

@{
    ViewData["Title"] = "Редактиране на артикул";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-slate-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">

        @* Секция с хедър *@
        <div class="mb-8 flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Редактиране на артикул</h1>
                <p class="mt-2 text-sm text-slate-500">Променете детайлите на вашия 3D модел.</p>
            </div>
            <a asp-controller="Store" asp-action="Articles" class="group flex items-center text-sm font-medium text-blue-600 hover:text-blue-700 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                Назад към магазина
            </a>
        </div>

        <div class="bg-white rounded-2xl shadow-xl shadow-slate-200/60 border border-slate-200 overflow-hidden">
            @* Формата сочи към Store/Edit/{id} *@
            <form asp-controller="Store" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="divide-y divide-slate-100">

                @* Важни скрити полета *@
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="FilePath" />

                <div asp-validation-summary="ModelOnly" class="p-4 bg-red-50 text-red-600 text-sm"></div>

                @* Секция: Основна информация *@
                <div class="p-8 space-y-6">
                    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                        <div class="sm:col-span-2">
                            <label asp-for="Name" class="block text-sm font-semibold text-slate-700 mb-2">Име на продукта</label>
                            <input asp-for="Name" type="text"
                                   placeholder="Въведете име..."
                                   class="block w-full rounded-xl border-slate-200 bg-slate-50/50 px-4 py-3 text-slate-900 focus:border-blue-500 focus:ring-blue-500 sm:text-sm transition-all border" />
                            <span asp-validation-for="Name" class="mt-2 text-xs text-red-500"></span>
                        </div>

                        <div class="sm:col-span-2">
                            <label asp-for="Description" class="block text-sm font-semibold text-slate-700 mb-2">Описание</label>
                            <textarea asp-for="Description" rows="3"
                                      placeholder="Опишете вашия модел..."
                                      class="block w-full rounded-xl border-slate-200 bg-slate-50/50 px-4 py-3 text-slate-900 focus:border-blue-500 focus:ring-blue-500 sm:text-sm transition-all border"></textarea>
                            <span asp-validation-for="Description" class="mt-2 text-xs text-red-500"></span>
                        </div>
                    </div>
                </div>

                @* Секция: Технически спецификации *@
                <div class="p-8 bg-slate-50/30 space-y-6">
                    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
                        <div>
                            <label asp-for="PrintType" class="block text-sm font-semibold text-slate-700 mb-2">Категория</label>
                            <select asp-for="PrintType" asp-items="Html.GetEnumSelectList<PrintType>()"
                                    class="block w-full rounded-xl border-slate-200 bg-white px-4 py-3 text-slate-900 focus:border-blue-500 focus:ring-blue-500 sm:text-sm border">
                            </select>
                        </div>

                        <div>
                            <label asp-for="MaterialType" class="block text-sm font-semibold text-slate-700 mb-2">Материал</label>
                            <select asp-for="MaterialType" asp-items="Html.GetEnumSelectList<MaterialType>()"
                                    class="block w-full rounded-xl border-slate-200 bg-white px-4 py-3 text-slate-900 focus:border-blue-500 focus:ring-blue-500 sm:text-sm border">
                            </select>
                        </div>

                        <div>
                            <label asp-for="Price" class="block text-sm font-semibold text-slate-700 mb-2">Цена (EUR)</label>
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm">€</span>
                                <input asp-for="Price" type="number" step="0.01"
                                       class="block w-full rounded-xl border-slate-200 bg-white pl-12 pr-4 py-3 text-slate-900 focus:border-blue-500 focus:ring-blue-500 sm:text-sm border" />
                            </div>
                            <span asp-validation-for="Price" class="mt-2 text-xs text-red-500"></span>
                        </div>

                        <div>
                            <label asp-for="Weight" class="block text-sm font-semibold text-slate-700 mb-2">Тегло (Грамове)</label>
                            <input asp-for="Weight" type="number" step="0.1"
                                   class="block w-full rounded-xl border-slate-200 bg-white px-4 py-3 text-slate-900 focus:border-blue-500 focus:ring-blue-500 sm:text-sm border" />
                            <span asp-validation-for="Weight" class="mt-2 text-xs text-red-500"></span>
                        </div>
                    </div>
                </div>

                @* Секция: Цветове и Изображение *@
                <div class="p-8 space-y-6">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-3">Налични цветове</label>
                        <div class="flex flex-wrap gap-3">
                            @foreach (var color in Enum.GetValues(typeof(PrintColor)).Cast<PrintColor>())
                            {
                                <label class="relative flex cursor-pointer items-center justify-center rounded-lg border border-slate-200 bg-white px-3 py-2 shadow-sm hover:bg-slate-50 transition-all has-[:checked]:border-blue-600 has-[:checked]:ring-1 has-[:checked]:ring-blue-600">
                                    <input type="checkbox"
                                           name="PrintColors"
                                           value="@color"
                                           class="sr-only"
                                           @(Model.PrintColors.Contains(color) ? "checked" : "") />
                                    <span class="text-xs font-medium text-slate-900">@color</span>
                                </label>
                            }
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-4">Снимка на продукта</label>

                        @* Показване на текущата снимка *@
                        @if (!string.IsNullOrEmpty(Model.FilePath))
                        {
                            <div class="mb-4 flex items-center space-x-4 p-4 bg-slate-50 rounded-xl border border-slate-200">
                                <img src="@Model.FilePath" class="h-20 w-20 object-cover rounded-lg shadow-sm" alt="Текуща снимка" />
                                <div class="text-xs text-slate-500">
                                    <p class="font-bold text-slate-700">Текущо изображение</p>
                                    <p>Оставете празно, за да запазите текущата снимка</p>
                                </div>
                            </div>
                        }

                        <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-slate-200 border-dashed rounded-xl hover:border-blue-400 transition-colors">
                            <div class="space-y-1 text-center">
                                <svg class="mx-auto h-12 w-12 text-slate-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                                    <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                <div class="flex text-sm text-slate-600 items-center gap-2 justify-center">
                                    <button type="button" onclick="document.getElementById('file-upload').click()" class="font-bold text-blue-600 hover:text-blue-500">
                                        Качете нов файл
                                    </button>
                                    <input id="file-upload" asp-for="File" type="file" class="hidden" accept="image/*" />
                                    <p id="file-name" class="pl-1 text-slate-400">или дръпнете тук</p>
                                </div>
                                <p class="text-xs text-slate-400">PNG, JPG, GIF до 10MB</p>
                            </div>
                        </div>
                    </div>
                </div>

                @* Бутон за изпращане *@
                <div class="p-8 flex items-center justify-center bg-slate-50/50">
                    <button type="submit" class="w-full sm:w-auto bg-blue-600 text-white px-10 py-4 rounded-xl font-bold shadow-lg hover:bg-blue-700 transition-all active:scale-95 flex items-center justify-center gap-2">
                        <i class="bi bi-check-circle-fill"></i>
                        Запази промените
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById('file-upload').addEventListener('change', function () {
            const fileNameEl = document.getElementById('file-name');
            if (this.files && this.files.length > 0) {
                fileNameEl.innerText = "Избран файл: " + this.files[0].name;
                fileNameEl.classList.add('text-blue-600', 'font-bold');
            }
        });
    </script>
}