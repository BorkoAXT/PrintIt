@model PrintIt.Models.Print
@using PrintIt.Enums
@using System.Security.Claims
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject PrintIt.Services.IFileService FileService
@{
    ViewData["Title"] = Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isFav = ViewBag.IsFavorite ?? false;
    var tokens = Antiforgery.GetAndStoreTokens(Context);

    // Get media from new folder structure
    var images = new List<string>();
    var model3D = string.Empty;

    if (!string.IsNullOrEmpty(Model.MediaFolderPath))
    {
        images = FileService.GetPrintImages(Model.MediaFolderPath);
        model3D = FileService.GetPrint3DModel(Model.MediaFolderPath) ?? string.Empty;
    }
}

<input type="hidden" id="af-token" value="@tokens.RequestToken" />

<div class="min-h-screen bg-slate-50/50 dark:bg-slate-950 py-12 px-4 sm:px-6 lg:px-8 transition-colors duration-500">
    <div class="max-w-6xl mx-auto">
        @* Breadcrumbs & Back Button *@
        <div class="mb-8 flex items-center justify-between">
            <div>
                <nav class="flex text-sm font-medium text-slate-500 dark:text-slate-400 mb-2">
                    <ol class="flex items-center space-x-2">
                        <li><a asp-controller="Store" asp-action="Articles" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Магазин</a></li>
                        <li><i class="bi bi-chevron-right text-[10px] text-slate-300 dark:text-slate-700"></i></li>
                        <li class="text-slate-900 dark:text-white font-bold">@Model.Name</li>
                    </ol>
                </nav>
                <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Детайли за продукта</h1>
            </div>
            <a asp-controller="Store" asp-action="Articles" class="group flex items-center text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 transition-colors">
                <i class="bi bi-arrow-left mr-2 transition-transform group-hover:-translate-x-1"></i>
                Назад към магазина
            </a>
        </div>

        <div class="lg:grid lg:grid-cols-2 lg:gap-x-12 lg:items-start">
            @* Left Column: Media Viewer *@
            <div class="flex flex-col">
                @* Media Type Tabs *@
                @if (images.Any() || !string.IsNullOrEmpty(model3D))
                {
                    <div class="flex gap-2 mb-4">
                        @if (images.Any())
                        {
                            <button type="button" onclick="switchMediaType('images')" id="images-tab" class="px-4 py-2 rounded-xl font-bold text-sm transition-all bg-blue-600 text-white shadow-lg">
                                <i class="bi bi-images mr-2"></i>Снимки (@images.Count)
                            </button>
                        }
                        @if (!string.IsNullOrEmpty(model3D))
                        {
                            <button type="button" onclick="switchMediaType('model')" id="model-tab" class="px-4 py-2 rounded-xl font-bold text-sm transition-all bg-white dark:bg-slate-900 text-slate-900 dark:text-white border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800">
                                <i class="bi bi-cube mr-2"></i>3D Модел
                            </button>
                        }
                    </div>
                }

                @* Image Viewer Section *@
                @if (images.Any())
                {
                    <div id="images-container" class="flex flex-col gap-4">
                        @* Main Image Display *@
                        <div class="w-full aspect-square rounded-3xl overflow-hidden bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl relative group">
                            <img id="main-image" src="@images.First()" alt="@Model.Name" class="w-full h-full object-cover cursor-zoom-in hover:scale-105 transition-transform duration-700" onclick="openImageLightbox(0)">

                            @* Image Navigation Arrows *@
                            <button type="button" onclick="previousImage()" class="absolute left-4 top-1/2 -translate-y-1/2 p-2 bg-white/80 dark:bg-slate-900/80 rounded-full opacity-0 group-hover:opacity-100 transition-opacity hover:bg-white dark:hover:bg-slate-800 shadow-lg">
                                <i class="bi bi-chevron-left text-slate-900 dark:text-white text-xl"></i>
                            </button>
                            <button type="button" onclick="nextImage()" class="absolute right-4 top-1/2 -translate-y-1/2 p-2 bg-white/80 dark:bg-slate-900/80 rounded-full opacity-0 group-hover:opacity-100 transition-opacity hover:bg-white dark:hover:bg-slate-800 shadow-lg">
                                <i class="bi bi-chevron-right text-slate-900 dark:text-white text-xl"></i>
                            </button>

                            @* Fullscreen Button *@
                            <button type="button" onclick="openImageLightbox(currentImageIndex)" class="absolute top-4 right-4 p-2 bg-white/80 dark:bg-slate-900/80 rounded-full opacity-0 group-hover:opacity-100 transition-opacity hover:bg-white dark:hover:bg-slate-800 shadow-lg">
                                <i class="bi bi-arrows-fullscreen text-slate-900 dark:text-white text-xl"></i>
                            </button>

                            @* Image Counter *@
                            <div class="absolute bottom-4 left-4 bg-slate-900/70 dark:bg-slate-100/10 text-white px-3 py-1 rounded-full text-sm font-bold backdrop-blur-sm">
                                <span id="image-counter">1</span> / @images.Count
                            </div>
                        </div>

                        @* Image Carousel Thumbnails *@
                        @if (images.Count > 1)
                        {
                            <div class="flex gap-2 overflow-x-auto pb-2">
                                @for (int i = 0; i < images.Count; i++)
                                {
                                    <button type="button" onclick="goToImage(@i)" id="thumb-@i" class="flex-shrink-0 w-20 h-20 rounded-lg overflow-hidden border-2 border-transparent hover:border-blue-400 transition-all @(i == 0 ? "border-blue-600" : "border-slate-200 dark:border-slate-700")">
                                        <img src="@images[i]" alt="Thumbnail @(i + 1)" class="w-full h-full object-cover">
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }

                @* 3D Model Viewer Section *@
                @if (!string.IsNullOrEmpty(model3D))
                {
                    <div id="model-container" class="hidden flex flex-col gap-4">
                        @* 3D Viewer Canvas *@
                        <div id="canvas-container" class="w-full aspect-square rounded-3xl overflow-hidden bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl relative">
                            <canvas id="3d-canvas" class="w-full h-full"></canvas>

                            @* 3D Controls Info *@
                            <div class="absolute bottom-4 left-4 bg-slate-900/70 dark:bg-slate-100/10 text-white px-3 py-2 rounded-lg text-xs font-bold backdrop-blur-sm space-y-1">
                                <div><i class="bi bi-mouse text-blue-400 mr-1"></i>Завърти: ЛКМ + Влачи</div>
                                <div><i class="bi bi-zoom-in text-blue-400 mr-1"></i>Увеличи: Скрол</div>
                                <div><i class="bi bi-arrows-move text-blue-400 mr-1"></i>Премести: Дясна КМ</div>
                            </div>

                            @* 3D Controls Buttons *@
                            <div class="absolute top-4 right-4 flex gap-2">
                                <button type="button" onclick="reset3DView()" class="p-2 bg-white/80 dark:bg-slate-900/80 rounded-full hover:bg-white dark:hover:bg-slate-800 shadow-lg transition-colors" title="Нулиране на изгледа">
                                    <i class="bi bi-arrow-counterclockwise text-slate-900 dark:text-white"></i>
                                </button>
                                <button type="button" onclick="download3DModel()" class="p-2 bg-white/80 dark:bg-slate-900/80 rounded-full hover:bg-white dark:hover:bg-slate-800 shadow-lg transition-colors" title="Изтегли модел">
                                    <i class="bi bi-download text-slate-900 dark:text-white"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }

                @* Tech Specs *@
                <div class="mt-8 grid grid-cols-2 gap-4">
                    <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm flex items-center gap-4 transition-colors">
                        <div class="p-3 bg-blue-50 dark:bg-blue-900/30 rounded-xl text-blue-600 dark:text-blue-400">
                            <i class="bi bi-layers-half text-xl"></i>
                        </div>
                        <div>
                            <span class="block text-[10px] uppercase font-black text-slate-400 dark:text-slate-500 tracking-widest">Материал</span>
                            <span class="text-slate-900 dark:text-white font-bold text-lg">@Model.MaterialType</span>
                        </div>
                    </div>
                    <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-100 dark:border-slate-800 shadow-sm flex items-center gap-4 transition-colors">
                        <div class="p-3 bg-orange-50 dark:bg-orange-900/30 rounded-xl text-orange-600 dark:text-orange-400">
                            <i class="bi bi-speedometer2 text-xl"></i>
                        </div>
                        <div>
                            <span class="block text-[10px] uppercase font-black text-slate-400 dark:text-slate-500 tracking-widest">Тегло</span>
                            <span class="text-slate-900 dark:text-white font-bold text-lg">@Model.Weight гр.</span>
                        </div>
                    </div>
                </div>
            </div>

            @* Right Column: Info & Selection *@
            <div class="mt-10 lg:mt-0 px-4">
                <div class="border-b border-slate-100 dark:border-slate-800 pb-6">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 mb-4 uppercase tracking-tighter transition-colors">
                        @Model.PrintType.ToString()
                    </span>
                    <h1 class="text-5xl font-black text-slate-900 dark:text-white tracking-tight mb-4">@Model.Name</h1>
                    <p class="text-3xl font-light text-blue-600 dark:text-blue-400">€ @Model.Price.ToString("F2")</p>
                </div>

                <div class="mt-8">
                    <h3 class="text-sm font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest mb-3">Описание</h3>
                    <div class="text-slate-600 dark:text-slate-300 leading-relaxed text-lg">
                        @Model.Description
                    </div>
                </div>

                @* Color Selection Area *@
                <div class="mt-10">
                    <div class="flex justify-between items-end mb-4">
                        <h3 class="text-sm font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest">Избери цветове</h3>
                        <span id="selection-count" class="text-[10px] font-black bg-blue-100 dark:bg-blue-900/50 text-blue-600 dark:text-blue-400 px-2 py-1 rounded-md hidden">0 ИЗБРАНИ</span>
                    </div>

                    <div class="flex flex-wrap gap-4">
                        @foreach (var color in Model.PrintColors)
                        {
                            var colorClass = color switch
                            {
                                PrintColor.Red => "bg-red-500",
                                PrintColor.Blue => "bg-blue-600",
                                PrintColor.Green => "bg-emerald-500",
                                PrintColor.Yellow => "bg-yellow-400",
                                PrintColor.Black => "bg-slate-900 ring-1 ring-slate-700",
                                PrintColor.White => "bg-white border border-slate-300",
                                PrintColor.Gray => "bg-slate-400",
                                PrintColor.Orange => "bg-orange-500",
                                PrintColor.Purple => "bg-purple-600",
                                PrintColor.Pink => "bg-pink-400",
                                PrintColor.Brown => "bg-amber-800",
                                PrintColor.Cyan => "bg-cyan-400",
                                PrintColor.Magenta => "bg-pink-600",
                                PrintColor.Lime => "bg-lime-400",
                                PrintColor.Multiple => "bg-gradient-to-tr from-red-500 via-green-500 to-blue-500",
                                _ => "bg-slate-200"
                            };

                            <button type="button"
                                    onclick="toggleColor(this, '@color')"
                                    class="color-swatch @colorClass w-12 h-12 rounded-xl shadow-md border-2 border-transparent hover:scale-110 transition-all cursor-pointer ring-offset-2 dark:ring-offset-slate-950 flex items-center justify-center">
                                <i class="bi bi-check-lg text-white text-xl check-icon hidden"></i>
                            </button>
                        }
                    </div>

                    @* Alpine.js Error Notification *@
                    <div x-data="{ show: false, message: '', trigger(msg) { this.message = msg; this.show = true; setTimeout(() => this.show = false, 3000); } }"
                         @@notify.window="trigger($event.detail.message)"
                         x-show="show"
                         x-transition
                         class="mt-6"
                         style="display: none;">
                        <div class="bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-400 px-4 py-3 rounded-xl border border-red-100 dark:border-red-900/30 flex items-center gap-3">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            <span class="font-bold text-sm" x-text="message"></span>
                        </div>
                    </div>
                </div>

                @* Action Buttons *@
                <div class="mt-10 space-y-4">
                    <form asp-controller="Cart" asp-action="AddToCart" method="post" id="add-to-cart-form" onsubmit="addToCart(event, this)">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div id="selected-colors-container"></div>

                        <button type="submit" id="add-btn" class="w-full bg-blue-600 text-white py-5 rounded-2xl text-xl font-black uppercase tracking-widest shadow-xl shadow-blue-200 dark:shadow-none hover:bg-blue-700 active:scale-[0.98] transition-all flex items-center justify-center gap-3">
                            <i class="bi bi-cart-plus-fill"></i>
                            Добави в количката
                        </button>
                    </form>

                    <button type="button"
                            onclick="handleWishlistClick('@Model.Id')"
                            id="wishlist-btn"
                            class="w-full py-4 rounded-2xl text-sm font-bold uppercase tracking-widest shadow-sm active:scale-[0.99] transition-all flex items-center justify-center gap-2 group border-2 @(isFav ? "bg-pink-50 dark:bg-pink-900/20 border-pink-100 dark:border-pink-900/30 text-pink-600 dark:text-pink-400" : "bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white hover:bg-slate-50 dark:hover:bg-slate-800")">
                        <i id="wishlist-icon" class="bi @(isFav ? "bi-heart-fill" : "bi-heart") transition-colors"></i>
                        <span id="wishlist-text">@(isFav ? "В любими" : "Добави в любими")</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@* Image Lightbox Modal *@
<div id="lightbox" class="hidden fixed inset-0 z-50 bg-black/95 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="relative w-full h-full flex flex-col items-center justify-center">
        @* Close Button *@
        <button type="button" onclick="closeLightbox()" class="absolute top-4 right-4 p-2 bg-white/10 hover:bg-white/20 rounded-full transition-colors z-10">
            <i class="bi bi-x-lg text-white text-2xl"></i>
        </button>

        @* Main Lightbox Image *@
        <div class="relative flex-1 flex items-center justify-center max-w-4xl">
            <img id="lightbox-image" src="" alt="Увеличено изображение" class="max-w-full max-h-full object-contain">

            @* Navigation Arrows *@
            <button type="button" onclick="previousImageLightbox()" class="absolute left-4 p-3 bg-white/10 hover:bg-white/20 rounded-full transition-colors">
                <i class="bi bi-chevron-left text-white text-2xl"></i>
            </button>
            <button type="button" onclick="nextImageLightbox()" class="absolute right-4 p-3 bg-white/10 hover:bg-white/20 rounded-colors">
                <i class="bi bi-chevron-right text-white text-2xl"></i>
            </button>

            @* Zoom Controls *@
            <div class="absolute bottom-4 left-4 flex gap-2 bg-white/10 backdrop-blur-sm p-3 rounded-lg">
                <button type="button" onclick="zoomImage(-0.1)" class="p-2 hover:bg-white/20 rounded transition-colors">
                    <i class="bi bi-zoom-out text-white"></i>
                </button>
                <div class="w-px bg-white/20"></div>
                <button type="button" onclick="resetImageZoom()" class="px-3 py-2 text-white text-sm font-bold hover:bg-white/20 rounded transition-colors">
                    Нулиране
                </button>
                <div class="w-px bg-white/20"></div>
                <button type="button" onclick="zoomImage(0.1)" class="p-2 hover:bg-white/20 rounded transition-colors">
                    <i class="bi bi-zoom-in text-white"></i>
                </button>
            </div>
        </div>

        @* Image Counter *@
        <div class="mt-4 text-white text-sm font-bold">
            <span id="lightbox-counter">1</span> / @images.Count
        </div>
    </div>
</div>

@section Scripts {
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@r128/examples/js/loaders/STLLoader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@r128/examples/js/controls/OrbitControls.js"></script>

    <script>
        // Image Gallery Variables
        const images = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(images));
        const model3DPath = '@model3D';
        let currentImageIndex = 0;
        let lightboxZoom = 1;
        let scene, camera, renderer, controls, model3D;

        // ===== IMAGE GALLERY FUNCTIONS =====
        function switchMediaType(type) {
            const imagesContainer = document.getElementById('images-container');
            const modelContainer = document.getElementById('model-container');
            const imagesTab = document.getElementById('images-tab');
            const modelTab = document.getElementById('model-tab');

            if (type === 'images') {
                imagesContainer.classList.remove('hidden');
                modelContainer.classList.add('hidden');
                imagesTab.classList.add('bg-blue-600', 'text-white', 'shadow-lg');
                imagesTab.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-900', 'dark:text-white', 'border', 'border-slate-200', 'dark:border-slate-800');
                modelTab.classList.remove('bg-blue-600', 'text-white', 'shadow-lg');
                modelTab.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-900', 'dark:text-white', 'border', 'border-slate-200', 'dark:border-slate-800');
            } else {
                imagesContainer.classList.add('hidden');
                modelContainer.classList.remove('hidden');
                modelTab.classList.add('bg-blue-600', 'text-white', 'shadow-lg');
                modelTab.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-900', 'dark:text-white', 'border', 'border-slate-200', 'dark:border-slate-800');
                imagesTab.classList.remove('bg-blue-600', 'text-white', 'shadow-lg');
                imagesTab.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-900', 'dark:text-white', 'border', 'border-slate-200', 'dark:border-slate-800');
                if (!renderer) init3DViewer();
            }
        }

        function goToImage(index) {
            currentImageIndex = index;
            updateMainImage();
            updateThumbnails();
        }

        function nextImage() {
            currentImageIndex = (currentImageIndex + 1) % images.length;
            updateMainImage();
            updateThumbnails();
        }

        function previousImage() {
            currentImageIndex = (currentImageIndex - 1 + images.length) % images.length;
            updateMainImage();
            updateThumbnails();
        }

        function updateMainImage() {
            document.getElementById('main-image').src = images[currentImageIndex];
            document.getElementById('image-counter').textContent = currentImageIndex + 1;
        }

        function updateThumbnails() {
            document.querySelectorAll('[id^="thumb-"]').forEach((thumb, i) => {
                if (i === currentImageIndex) {
                    thumb.classList.add('border-blue-600');
                    thumb.classList.remove('border-slate-200', 'dark:border-slate-700');
                } else {
                    thumb.classList.remove('border-blue-600');
                    thumb.classList.add('border-slate-200', 'dark:border-slate-700');
                }
            });
        }

        function openImageLightbox(index) {
            currentImageIndex = index;
            document.getElementById('lightbox-image').src = images[currentImageIndex];
            document.getElementById('lightbox-counter').textContent = currentImageIndex + 1;
            document.getElementById('lightbox').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            lightboxZoom = 1;
            updateLightboxImageZoom();
        }

        function closeLightbox() {
            document.getElementById('lightbox').classList.add('hidden');
            document.body.style.overflow = '';
            lightboxZoom = 1;
        }

        function nextImageLightbox() {
            currentImageIndex = (currentImageIndex + 1) % images.length;
            document.getElementById('lightbox-image').src = images[currentImageIndex];
            document.getElementById('lightbox-counter').textContent = currentImageIndex + 1;
            lightboxZoom = 1;
            updateLightboxImageZoom();
        }

        function previousImageLightbox() {
            currentImageIndex = (currentImageIndex - 1 + images.length) % images.length;
            document.getElementById('lightbox-image').src = images[currentImageIndex];
            document.getElementById('lightbox-counter').textContent = currentImageIndex + 1;
            lightboxZoom = 1;
            updateLightboxImageZoom();
        }

        function zoomImage(delta) {
            lightboxZoom = Math.max(0.5, Math.min(3, lightboxZoom + delta));
            updateLightboxImageZoom();
        }

        function resetImageZoom() {
            lightboxZoom = 1;
            updateLightboxImageZoom();
        }

        function updateLightboxImageZoom() {
            const img = document.getElementById('lightbox-image');
            img.style.transform = `scale(${lightboxZoom})`;
            img.style.transition = 'transform 0.3s ease';
        }

        // Keyboard navigation
        document.addEventListener('keydown', (e) => {
            const lightbox = document.getElementById('lightbox');
            if (lightbox.classList.contains('hidden')) return;

            if (e.key === 'ArrowRight') nextImageLightbox();
            if (e.key === 'ArrowLeft') previousImageLightbox();
            if (e.key === 'Escape') closeLightbox();
            if (e.key === '+' || e.key === '=') zoomImage(0.1);
            if (e.key === '-') zoomImage(-0.1);
            if (e.key === '0') resetImageZoom();
        });

        // ===== 3D VIEWER FUNCTIONS =====
        function init3DViewer() {
            const container = document.getElementById('canvas-container');
            const canvas = document.getElementById('3d-canvas');
            const width = container.clientWidth;
            const height = container.clientHeight;

            // Scene setup
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0xf8fafc);

            // Camera
            camera = new THREE.PerspectiveCamera(75, width / height, 0.1, 1000);
            camera.position.z = 150;

            // Renderer
            renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
            renderer.setSize(width, height);
            renderer.setPixelRatio(window.devicePixelRatio);

            // Lighting
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
            scene.add(ambientLight);

            const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
            directionalLight.position.set(5, 10, 7);
            scene.add(directionalLight);

            // Controls
            controls = new THREE.OrbitControls(camera, canvas);
            controls.enableDamping = true;
            controls.dampingFactor = 0.05;
            controls.autoRotate = true;
            controls.autoRotateSpeed = 4;

            // Load 3D model
            load3DModel();

            // Animation loop
            function animate() {
                requestAnimationFrame(animate);
                controls.update();
                renderer.render(scene, camera);
            }
            animate();

            // Handle window resize
            window.addEventListener('resize', () => {
                const newWidth = container.clientWidth;
                const newHeight = container.clientHeight;
                camera.aspect = newWidth / newHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(newWidth, newHeight);
            });
        }

        function load3DModel() {
            if (!model3DPath) return;

            const loader = new THREE.STLLoader();
            loader.load(model3DPath, (geometry) => {
                geometry.computeBoundingBox();
                geometry.center();

                const material = new THREE.MeshPhongMaterial({
                    color: 0x2563eb,
                    emissive: 0x072534,
                    shininess: 200
                });
                model3D = new THREE.Mesh(geometry, material);
                scene.add(model3D);

                // Fit camera to model
                const bbox = geometry.boundingBox;
                const size = bbox.getSize(new THREE.Vector3());
                const maxDim = Math.max(size.x, size.y, size.z);
                camera.position.z = maxDim * 2;
                controls.target.copy(geometry.boundingSphere.center);
                controls.update();
            });
        }

        function reset3DView() {
            if (model3D) {
                controls.reset();
                const bbox = model3D.geometry.boundingBox;
                const size = bbox.getSize(new THREE.Vector3());
                const maxDim = Math.max(size.x, size.y, size.z);
                camera.position.z = maxDim * 2;
                controls.target.copy(model3D.geometry.boundingSphere.center);
                controls.update();
            }
        }

        function download3DModel() {
            const link = document.createElement('a');
            link.href = model3DPath;
            link.download = '@Model.Name.Replace(" ", "_") + "_3D_Model"';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // ===== EXISTING COLOR AND CART FUNCTIONS =====
        const colorHexMap = {
            'Red': '#ef4444',
            'Blue': '#2563eb',
            'Green': '#10b981',
            'Yellow': '#facc15',
            'Black': '#0f172a',
            'White': '#ffffff',
            'Gray': '#94a3b8',
            'Orange': '#f97316',
            'Purple': '#9333ea',
            'Pink': '#f472b6',
            'Brown': '#78350f',
            'Cyan': '#22d3ee',
            'Magenta': '#db2777',
            'Lime': '#a3e635',
            'Multiple': 'linear-gradient(to right, #ef4444, #10b981, #2563eb)'
        };

        let selectedColors = [];

        function toggleColor(element, colorName) {
            const checkIcon = element.querySelector('.check-icon');
            const index = selectedColors.indexOf(colorName);

            if (index > -1) {
                selectedColors.splice(index, 1);
                element.classList.remove('ring-4', 'ring-blue-500', 'border-white');
                checkIcon.classList.add('hidden');
            } else {
                selectedColors.push(colorName);
                element.classList.add('ring-4', 'ring-blue-500', 'border-white');
                checkIcon.classList.remove('hidden');

                const lightColors = ['White', 'Yellow', 'Lime', 'Cyan'];
                if(lightColors.includes(colorName)) {
                    checkIcon.classList.replace('text-white', 'text-slate-900');
                } else {
                    checkIcon.classList.replace('text-slate-900', 'text-white');
                }
            }
            updateColorInputs();
            updateSelectionUI();
        }

        function updateColorInputs() {
            const container = document.getElementById('selected-colors-container');
            container.innerHTML = '';
            selectedColors.forEach(color => {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'selectedColors';
                input.value = color;
                container.appendChild(input);
            });
        }

        function updateSelectionUI() {
            const badge = document.getElementById('selection-count');
            if (selectedColors.length > 0) {
                badge.textContent = `${selectedColors.length} ИЗБРАНИ`;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }
        }

        async function addToCart(event, form) {
            event.preventDefault();
            if (selectedColors.length === 0) {
                window.dispatchEvent(new CustomEvent('notify', { detail: { message: "Моля, изберете поне един цвят!" } }));
                return;
            }

            const button = form.querySelector('button');
            const originalContent = button.innerHTML;
            const hexCodes = selectedColors.map(c => colorHexMap[c] || '#3b82f6');
            const firstColorHex = hexCodes[0];

            try {
                const formData = new FormData(form);
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value }
                });

                const result = await response.json();

                if (result.success) {
                    if (typeof window.refreshCartUI === "function") {
                        await window.refreshCartUI();
                    }

                    const toast = document.getElementById('cart-status-msg');
                    if (toast) {
                        toast.classList.remove('opacity-0', '-translate-y-[10px]');
                        toast.classList.add('opacity-100', 'translate-y-0');
                        setTimeout(() => {
                            toast.classList.add('opacity-0', '-translate-y-[10px]');
                            toast.classList.remove('opacity-100', 'translate-y-0');
                        }, 2000);
                    }

                    if (typeof animateFlyToCart === "function") {
                        let fill = selectedColors.includes('Multiple')
                            ? colorHexMap['Multiple']
                            : (hexCodes.length > 1 ? `linear-gradient(to right, ${hexCodes.join(',')})` : firstColorHex);
                        animateFlyToCart(button, fill);
                    }

                    button.style.background = selectedColors.includes('Multiple') ? colorHexMap['Multiple'] : (hexCodes.length > 1 ? `linear-gradient(to right, ${hexCodes.join(',')})` : firstColorHex);
                    button.innerHTML = '<i class="bi bi-check-all"></i> Добавено!';
                    button.disabled = true;
                }
            } catch (error) { console.error(error); }

            setTimeout(() => {
                button.disabled = false;
                button.innerHTML = originalContent;
                button.style.background = '';
            }, 1500);
        }

        async function handleWishlistClick(printId) {
            const token = document.getElementById('af-token').value;
            const btn = document.getElementById('wishlist-btn');
            const icon = document.getElementById('wishlist-icon');
            const text = document.getElementById('wishlist-text');

            try {
                const response = await fetch('/Store/ToggleWishlist', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                    body: new URLSearchParams({ 'id': printId })
                });
                if (response.status === 401) { window.location.href = '/Identity/Account/Login'; return; }
                const data = await response.json();
                if (data.success) {
                    if (data.isFavorite) {
                        btn.classList.add('bg-pink-50', 'dark:bg-pink-900/20', 'text-pink-600', 'dark:text-pink-400', 'border-pink-100', 'dark:border-pink-900/30');
                        btn.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-900', 'dark:text-white', 'border-slate-200', 'dark:border-slate-800');
                        icon.classList.replace('bi-heart', 'bi-heart-fill');
                        text.textContent = "В любими";
                    } else {
                        btn.classList.remove('bg-pink-50', 'dark:bg-pink-900/20', 'text-pink-600', 'dark:text-pink-400', 'border-pink-100', 'dark:border-pink-900/30');
                        btn.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-900', 'dark:text-white', 'border-slate-200', 'dark:border-slate-800');
                        icon.classList.replace('bi-heart-fill', 'bi-heart');
                        text.textContent = "Добави в любими";
                    }
                }
            } catch (e) { console.error(e); }
        }
    </script>
}