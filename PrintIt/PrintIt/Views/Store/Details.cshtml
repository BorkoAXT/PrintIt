@model PrintIt.Models.Print
@using PrintIt.Enums

@{
    ViewData["Title"] = Model.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var imageSrc = !string.IsNullOrEmpty(Model.FilePath)
                    ? Model.FilePath
                    : $"/images/{Model.Id}.png";
}

<div class="min-h-screen bg-slate-50/50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">

        @* Header Section - Styled exactly like the Add3DPrint page *@
        <div class="mb-8 flex items-center justify-between">
            <div>
                <nav class="flex text-sm font-medium text-slate-500 mb-2">
                    <ol class="flex items-center space-x-2">
                        <li><a asp-controller="Store" asp-action="Articles" class="hover:text-blue-600 transition-colors">Магазин</a></li>
                        <li><svg class="h-4 w-4 text-slate-300" fill="currentColor" viewBox="0 0 20 20"><path d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" /></svg></li>
                        <li class="text-slate-900 font-bold">Детайли</li>
                    </ol>
                </nav>
                <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">@Model.Name</h1>
            </div>

            <a asp-controller="Store" asp-action="Articles" class="group flex items-center text-sm font-medium text-blue-600 hover:text-blue-700 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                Назад към магазина
            </a>
        </div>

        <div class="lg:grid lg:grid-cols-2 lg:gap-x-12 lg:items-start">

            @* Image and Stats Column *@
            <div class="flex flex-col">
                <div class="w-full aspect-square rounded-3xl overflow-hidden bg-white border border-slate-200 shadow-xl">
                    <img src="@imageSrc" alt="@Model.Name" class="w-full h-full object-cover hover:scale-105 transition-transform duration-700">
                </div>

                <div class="mt-8 grid grid-cols-2 gap-4">
                    <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex items-center gap-4">
                        <div class="p-3 bg-blue-50 rounded-xl text-blue-600">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>
                        </div>
                        <div>
                            <span class="block text-[10px] uppercase font-black text-slate-400">Материал</span>
                            <span class="text-slate-900 font-bold text-lg">@Model.MaterialType</span>
                        </div>
                    </div>
                    <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm flex items-center gap-4">
                        <div class="p-3 bg-orange-50 rounded-xl text-orange-600">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" /></svg>
                        </div>
                        <div>
                            <span class="block text-[10px] uppercase font-black text-slate-400">Тегло</span>
                            <span class="text-slate-900 font-bold text-lg">@Model.Weight g</span>
                        </div>
                    </div>
                </div>
            </div>

            @* Product Details Column *@
            <div class="mt-10 lg:mt-0 px-4">
                <div class="border-b border-slate-100 pb-6">
                    <h1 class="text-5xl font-black text-slate-900 tracking-tight mb-4">@Model.Name</h1>
                    <p class="text-3xl font-light text-blue-600">@Model.Price.ToString("F2") <span class="text-sm font-bold uppercase">BGN</span></p>
                </div>

                <div class="mt-8">
                    <h3 class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-3">Описание</h3>
                    <div class="text-slate-600 leading-relaxed text-lg">@Model.Description</div>
                </div>

                <div class="mt-10">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-sm font-bold text-slate-400 uppercase tracking-widest">Избери цвят</h3>
                        <span class="text-[10px] text-blue-500 font-bold uppercase italic">* Можеш да избереш няколко</span>
                    </div>

                    <div class="flex flex-wrap gap-4" id="colorContainer">
                        @foreach (var color in Model.PrintColors.Where(c => c != PrintColor.None && c != PrintColor.Multiple))
                        {
                            var colorClass = color switch
                            {
                                PrintColor.Red => "bg-red-500",
                                PrintColor.Blue => "bg-blue-600",
                                PrintColor.Green => "bg-emerald-500",
                                PrintColor.Yellow => "bg-yellow-400",
                                PrintColor.Black => "bg-slate-900",
                                PrintColor.White => "bg-white border-slate-200",
                                PrintColor.Gray => "bg-slate-400",
                                PrintColor.Orange => "bg-orange-500",
                                PrintColor.Purple => "bg-purple-600",
                                PrintColor.Pink => "bg-pink-400",
                                PrintColor.Brown => "bg-amber-800",
                                PrintColor.Cyan => "bg-cyan-400",
                                PrintColor.Magenta => "bg-fuchsia-600",
                                PrintColor.Lime => "bg-lime-400",
                                _ => "bg-slate-200"
                            };

                            <button type="button"
                                    onclick="toggleColor(this, '@color')"
                                    class="color-swatch group relative w-12 h-12 rounded-xl shadow-md border-4 border-transparent transition-all hover:scale-110 active:scale-95 @colorClass"
                                    title="@color">
                                <svg class="checkmark hidden absolute inset-0 m-auto h-6 w-6 text-white mix-blend-difference" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M5 13l4 4L19 7" />
                                </svg>
                            </button>
                        }
                    </div>
                </div>

                <form asp-action="AddToCart" method="post" class="mt-12 space-y-4">
                    <input type="hidden" name="PrintId" value="@Model.Id" />
                    <input type="hidden" id="selectedColorsInput" name="SelectedColors" value="" />

                    <button type="submit" class="w-full bg-blue-600 text-white py-5 rounded-2xl text-xl font-black uppercase tracking-widest shadow-xl shadow-blue-200 hover:bg-blue-700 active:scale-[0.98] transition-all flex items-center justify-center gap-3">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
                        Добави в количката
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let selectedColors = [];

        function toggleColor(element, colorName) {
            const checkmark = element.querySelector('.checkmark');
            const inputField = document.getElementById('selectedColorsInput');

            if (selectedColors.includes(colorName)) {
                // Deselect
                selectedColors = selectedColors.filter(c => c !== colorName);
                element.classList.remove('border-blue-500', 'ring-4', 'ring-blue-100');
                checkmark.classList.add('hidden');
            } else {
                // Select
                selectedColors.push(colorName);
                element.classList.add('border-blue-500', 'ring-4', 'ring-blue-100');
                checkmark.classList.remove('hidden');
            }

            // Update hidden input with comma-separated list
            inputField.value = selectedColors.join(',');
        }
    </script>
}