@model PrintIt.ViewModels.StoreIndexViewModel
@using PrintIt.Enums
@{
    ViewData["Title"] = "Магазин";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isSearching = !string.IsNullOrEmpty(ViewData["SearchTerm"] as string);

    async Task RenderStoreSection(string title, List<PrintIt.Models.Print> sectionItems, PrintType type)
    {
        <div class="mb-16">
            <div class="flex items-end justify-between mb-8 border-b border-slate-100 pb-4">
                <div>
                    <h2 class="text-3xl font-black text-brand-dark tracking-tight">@title</h2>
                    <p class="text-slate-400 text-sm font-medium uppercase tracking-wider mt-1">Топ предложения</p>
                </div>
                <a asp-action="Category" asp-route-type="@type.ToString()" class="group flex items-center gap-2 text-brand-primary font-bold hover:text-brand-dark transition-all">
                    Виж всички <i class="bi bi-arrow-right transition-transform group-hover:translate-x-1"></i>
                </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
                @foreach (var item in sectionItems)
                {
                    <partial name="_ProductCard" model="item" />
                }
            </div>
        </div>
    }
}

<div class="max-w-7xl mx-auto px-4 pt-4">
    @* Header and Search *@
    <div class="mb-12 -mt-2">
        <div class="flex items-center justify-between mb-8">
            <h1 class="text-5xl font-black text-brand-dark tracking-tight">Артикули</h1>
            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
            {
                <a asp-action="Add3DPrint" class="bg-brand-primary text-white p-4 rounded-full shadow-lg hover:scale-110 transition-transform">
                    <i class="bi bi-plus-lg text-2xl"></i>
                </a>
            }
        </div>

        <form asp-action="Articles" method="get" class="max-w-2xl relative group">
            <input type="text" name="searchString" value="@ViewData["SearchTerm"]"
                   placeholder="Търси модел (напр. Dragon)..."
                   class="w-full bg-white border-2 border-slate-100 rounded-2xl py-4 pl-12 pr-32 shadow-sm focus:border-brand-primary focus:ring-0 transition-all outline-none" />
            <i class="bi bi-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xl group-focus-within:text-brand-primary"></i>
            <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 bg-brand-primary text-white px-6 py-2.5 rounded-xl font-bold hover:bg-brand-dark transition-all">
                Търси
            </button>
        </form>

        @if (isSearching)
        {
            <div class="mt-4 flex items-center gap-3">
                <span class="text-slate-500">Резултати за <b class="text-brand-dark">"@ViewData["SearchTerm"]"</b></span>
                <a asp-action="Articles" class="text-red-500 font-bold text-xs uppercase tracking-widest hover:underline">Изчисти</a>
            </div>
        }
    </div>

    @if (isSearching)
    {
        @if (!Model.SearchResults.Any())
        {
            <div class="py-20 text-center bg-slate-50 rounded-3xl border-2 border-dashed border-slate-200">
                <i class="bi bi-search text-5xl text-slate-200 mb-4 block"></i>
                <h3 class="text-xl font-bold text-slate-600">Няма открити резултати</h3>
                <p class="text-slate-400">Опитай с друга ключова дума.</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-20">
                @foreach (var item in Model.SearchResults)
                {
                    <partial name="_ProductCard" model="item" />
                }
            </div>
        }
    }
    else
    {
        @* Sections *@
        await RenderStoreSection("Фигурки", Model.RecentFigures, PrintType.Figure);
        await RenderStoreSection("Играчки", Model.RecentFidgetToys, PrintType.FidgetToy);
        await RenderStoreSection("Аксесоари", Model.RecentAccessories, PrintType.Accessory);
    }
</div>

@section Scripts {
    <script>
        let addCount = 0;
        let hideTimeout;

        async function addToCart(event, form) {
            event.preventDefault();
            const button = form.querySelector('button');
            const originalText = button.innerHTML;

            try {
                const formData = new FormData(form);
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                });

                if (response.url.includes("Account/Login")) {
                    window.location.href = response.url;
                    return;
                }

                if (response.ok) {
                    button.disabled = true;
                    button.innerHTML = '<i class="bi bi-check2 text-lg"></i>';
                    button.classList.add('bg-green-500', 'text-white', 'border-green-500');

                    const msg = document.getElementById('cart-status-msg');
                    const cartIcon = document.querySelector('#cart-nav-link i');

                    if (msg) {
                        addCount++;
                        msg.innerText = addCount > 1 ? `+${addCount} добавени!` : '+1 добавен!';
                        msg.classList.remove('opacity-0', 'translate-y-[-5px]');
                        msg.classList.add('opacity-100', 'translate-y-0');

                        if (cartIcon) {
                            cartIcon.classList.add('scale-125', 'text-brand-primary');
                            setTimeout(() => cartIcon.classList.remove('scale-125', 'text-brand-primary'), 200);
                        }

                        clearTimeout(hideTimeout);
                        hideTimeout = setTimeout(() => {
                            msg.classList.replace('opacity-100', 'opacity-0');
                            msg.classList.replace('translate-y-0', 'translate-y-[-5px]');
                            addCount = 0;
                        }, 2500);
                    }
                }
            } catch (error) {
                console.error("Грешка:", error);
            }

            setTimeout(() => {
                button.disabled = false;
                button.innerHTML = originalText;
                button.classList.remove('bg-green-500', 'text-white', 'border-green-500');
            }, 800);
        }
    </script>

    <style>
        #cart-nav-link i {
            transition: all 0.2s ease-in-out;
        }

        @* Relaxed transition for the cart status message *@
        .group-hover\/section\:opacity-100 {
            transition: opacity 0.3s ease-in-out;
        }
    </style>
}