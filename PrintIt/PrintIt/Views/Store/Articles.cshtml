@using PrintIt.Enums
@using PrintIt.Models
@{
    ViewData["Title"] = "Артикули";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var items = ViewData["Items"] as List<Print>;

    var figures = items?.Where(i => i.PrintType == PrintType.Figure).ToList() ?? new List<Print>();
    var fidgetToys = items?.Where(i => i.PrintType == PrintType.FidgetToy).ToList() ?? new List<Print>();
    var accessories = items?.Where(i => i.PrintType == PrintType.Accessory).ToList() ?? new List<Print>();

    async Task RenderStoreSection(string title, List<Print> sectionItems, string gridId, string itemLabel)
    {
        <div class="relative group/section mb-16">
            <div class="flex items-center justify-between mb-6 border-b border-slate-100 pb-2">
                <h2 class="text-xl font-bold text-slate-400 uppercase tracking-widest">@title</h2>
            </div>

            @if (sectionItems == null || !sectionItems.Any())
            {
                <div class="flex flex-col items-center justify-center py-20 bg-slate-50 rounded-3xl border-2 border-dashed border-slate-200 text-center">
                    <div class="w-20 h-20 bg-slate-100 rounded-full flex items-center justify-center mb-4">
                        <i class="bi bi-box-seam text-slate-400 text-3xl"></i>
                    </div>
                    <h3 class="text-xl font-bold text-slate-600">Няма налични @title.ToLower() в момента.</h3>
                </div>
            }
            else
            {
                <div class="relative px-2">
                    @if (sectionItems.Count > 4)
                    {
                        <button onclick="scrollGrid('@gridId', -1)"
                                class="absolute -left-4 top-1/2 -translate-y-1/2 z-30 p-2 rounded-full border border-slate-200 bg-white shadow-lg text-slate-600 hover:bg-brand-primary hover:text-white transition-all opacity-0 group-hover/section:opacity-100">
                            <i class="bi bi-chevron-left text-lg"></i>
                        </button>

                        <button onclick="scrollGrid('@gridId', 1)"
                                class="absolute -right-4 top-1/2 -translate-y-1/2 z-30 p-2 rounded-full border border-slate-200 bg-white shadow-lg text-slate-600 hover:bg-brand-primary hover:text-white transition-all opacity-0 group-hover/section:opacity-100">
                            <i class="bi bi-chevron-right text-lg"></i>
                        </button>
                    }

                    <div id="@gridId" class="flex overflow-x-auto scrollbar-hide snap-x snap-mandatory gap-8 pb-4 scroll-smooth">
                        @foreach (var item in sectionItems)
                        {
                            <div class="snap-start shrink-0 w-full sm:w-[calc(50%-1rem)] lg:w-[calc(25%-1.5rem)] group relative flex flex-col">
                                <div class="aspect-square w-full overflow-hidden rounded-2xl bg-slate-100 border border-slate-200 transition-all group-hover:shadow-xl group-hover:shadow-brand-primary/10 group-hover:-translate-y-1">
                                    @{
                                        var imagePath = !string.IsNullOrEmpty(item.FilePath) ? item.FilePath : "/images/placeholder-figure.jpg";
                                    }
                                    <img src="@imagePath" alt="@item.Name" class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-110" />

                                    <div class="absolute inset-0 bg-brand-dark/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center z-20">
                                        <a asp-controller="Store" asp-action="Details" asp-route-id="@item.Id" class="bg-white text-brand-dark px-4 py-2 rounded-lg font-bold text-sm shadow-xl transform translate-y-4 group-hover:translate-y-0 transition-transform">
                                            Виж детайли
                                        </a>
                                    </div>
                                </div>

                                <div class="mt-4 flex flex-col flex-grow">
                                    <div class="flex justify-between items-start gap-2">
                                        <h3 class="text-base font-bold text-brand-dark truncate">
                                            <a asp-controller="Store" asp-action="Details" asp-route-id="@item.Id" class="hover:text-brand-primary transition-colors">@item.Name</a>
                                        </h3>
                                        <p class="text-lg font-black text-brand-primary whitespace-nowrap">€ @item.Price.ToString("F2")</p>
                                    </div>

                                    <p class="mt-1 text-xs font-medium text-slate-400 uppercase tracking-tighter">
                                        <i class="bi bi-cpu text-brand-primary"></i> 3D принтирана @itemLabel
                                    </p>

                                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                                    {
                                        <div class="mt-3 flex gap-2">
                                            <a asp-action="Details" asp-route-id="@item.Id"
                                               class="flex-1 py-2 bg-slate-50 hover:bg-slate-200 border border-slate-200 text-slate-600 font-bold rounded-xl transition-all text-sm text-center">
                                                Детайли
                                            </a>
                                            <a asp-controller="Store" asp-action="Edit" asp-route-id="@item.Id"
                                               class="flex-1 py-2 bg-brand-primary hover:bg-brand-dark text-white font-bold rounded-xl transition-all text-sm text-center">
                                                Редактирай
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mt-auto pt-3">
                                            <form onsubmit="addToCart(event, this)" action="@Url.Action("AddToCart", "Cart")" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="w-full py-2.5 bg-slate-50 hover:bg-brand-primary hover:text-white border border-slate-200 text-slate-600 font-bold rounded-xl transition-all text-sm">
                                                    Добави в количката
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
}

<div class="relative min-h-[60vh] pb-24 max-w-7xl mx-auto px-4">
    <div class="border-b border-slate-100 pb-6 mb-12 flex items-center justify-between">
        <div>
            <h1 class="text-5xl font-extrabold text-brand-dark tracking-tight">Артикули</h1>
            <p class="text-slate-500 mt-2 text-lg">Разгледайте нашата колекция от висококачествени 3D принтирани модели.</p>
        </div>

        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
        {
            <div class="flex-shrink-0">
                <a asp-controller="Store" asp-action="Add3DPrint"
                   title="Добави нов артикул"
                   class="group relative flex h-14 w-14 items-center justify-center rounded-full shadow-lg transition-all duration-300 hover:scale-110 active:scale-95 border-2 border-[#1861ac]"
                   style="background-color: #1b6ec2;">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="white" class="h-7 w-7 transition-transform duration-500 group-hover:rotate-180">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                    </svg>
                </a>
            </div>
        }
    </div>

    @{
        await RenderStoreSection("Фигурки", figures, "grid-figures", "фигурка");
        await RenderStoreSection("Играчки", fidgetToys, "grid-fidget", "играчка");
        await RenderStoreSection("Аксесоари", accessories, "grid-accessories", "аксесоар");
    }
</div>

@section Scripts {
    <script>
        function scrollGrid(gridId, direction) {
            const grid = document.getElementById(gridId);
            if (!grid) return;
            const cardWidth = grid.querySelector('.snap-start').offsetWidth;
            const gap = 32;
            const scrollAmount = (cardWidth + gap) * direction;
            grid.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        }

        let addCount = 0;
        let hideTimeout;

        async function addToCart(event, form) {
            event.preventDefault();

            const button = form.querySelector('button');
            const originalText = button.innerHTML;

            try {
                const formData = new FormData(form);
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                });

                // REDIRECT CHECK: If not logged in, redirect to login page
                if (response.url.includes("Account/Login")) {
                    window.location.href = response.url;
                    return;
                }

                if (response.ok) {
                    // Update button appearance (Your original logic)
                    button.disabled = true;
                    button.innerHTML = '<i class="bi bi-check2 text-lg"></i>';
                    button.classList.add('bg-green-500', 'text-white', 'border-green-500');

                    // Show the green message (Your original logic)
                    const msg = document.getElementById('cart-status-msg');
                    const cartIcon = document.querySelector('#cart-nav-link i');

                    if (msg) {
                        addCount++;
                        msg.innerText = addCount > 1 ? `+${addCount} добавени!` : '+1 добавен!';
                        msg.classList.remove('opacity-0', 'translate-y-[-5px]');
                        msg.classList.add('opacity-100', 'translate-y-0');

                        if (cartIcon) {
                            cartIcon.classList.add('scale-125', 'text-brand-primary');
                            setTimeout(() => cartIcon.classList.remove('scale-125', 'text-brand-primary'), 200);
                        }

                        clearTimeout(hideTimeout);
                        hideTimeout = setTimeout(() => {
                            msg.classList.replace('opacity-100', 'opacity-0');
                            msg.classList.replace('translate-y-0', 'translate-y-[-5px]');
                            addCount = 0;
                        }, 2500);
                    }
                }
            } catch (error) {
                console.error("Грешка при добавяне в количката:", error);
            }

            // Revert button (Your original logic)
            setTimeout(() => {
                button.disabled = false;
                button.innerHTML = originalText;
                button.classList.remove('bg-green-500', 'text-white', 'border-green-500');
            }, 800);
        }
    </script>

    <style>
        .scrollbar-hide::-webkit-scrollbar {
            display: none;
        }

        .scrollbar-hide {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .group\/section:hover .group-hover\/section\:opacity-100 {
            opacity: 1;
        }

        .group-hover\/section\:opacity-100 {
            transition: opacity 0.3s ease-in-out;
        }

        #cart-nav-link i {
            transition: all 0.2s ease-in-out;
        }
    </style>
}