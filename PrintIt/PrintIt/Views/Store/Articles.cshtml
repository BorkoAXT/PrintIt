@model PrintIt.ViewModels.StoreSearchViewModel
@using PrintIt.Enums
@{
    ViewData["Title"] = "Магазин";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isFiltering = (bool)(ViewData["IsFiltering"] ?? false);

    async Task RenderStoreSection(string title, List<PrintIt.Models.Print> sectionItems, PrintType type)
    {
        <div class="mb-16">
            @* Section Header - Added Dark Mode Border and Text *@
            <div class="flex items-end justify-between mb-8 border-b border-slate-100 dark:border-slate-800 pb-4">
                <div>
                    <h2 class="text-3xl font-black text-brand-dark dark:text-white tracking-tight">@title</h2>
                    <p class="text-slate-400 dark:text-slate-500 text-sm font-medium uppercase tracking-wider mt-1 transition-colors">Топ предложения</p>
                </div>
                <a asp-action="Category" asp-route-type="@type.ToString()" class="group flex items-center gap-2 text-brand-primary font-bold hover:text-brand-dark dark:hover:text-blue-400 transition-all">
                    Виж всички <i class="bi bi-arrow-right transition-transform group-hover:translate-x-1"></i>
                </a>
            </div>

            @if (sectionItems == null || !sectionItems.Any())
            {
                @* Empty State for Category *@
                <div class="flex flex-col items-center justify-center py-20 bg-slate-50 dark:bg-slate-900/40 rounded-3xl border-2 border-dashed border-slate-200 dark:border-slate-800 text-center transition-colors">
                    <div class="w-20 h-20 bg-slate-100 dark:bg-slate-800 rounded-full flex items-center justify-center mb-4 transition-colors">
                        <i class="bi bi-box-seam text-slate-400 dark:text-slate-600 text-3xl"></i>
                    </div>
                    <h3 class="text-xl font-bold text-slate-600 dark:text-slate-400">Няма налични @title.ToLower() в момента.</h3>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
                    @foreach (var item in sectionItems)
                    {
                        <partial name="_ProductCard" model="item" />
                    }
                </div>
            }
        </div>
    }
}

<div class="max-w-7xl mx-auto px-4 pt-4 pb-20 transition-colors duration-500">
    @* Main Page Header *@
    <div class="flex items-center justify-between mb-10">
        <div class="flex items-center gap-5">
            <h1 class="text-5xl font-black text-brand-dark dark:text-white tracking-tight">Магазин</h1>

            @* Filter Toggle Button *@
            <button type="button" onclick="toggleFilters()"
                    class="relative p-3.5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:text-brand-primary hover:border-brand-primary transition-all shadow-sm group">
                <i id="filterIcon" class="bi bi-sliders2-vertical text-2xl transition-transform duration-300 @(isFiltering ? "rotate-90 text-brand-primary" : "")"></i>

                @if (isFiltering)
                {
                    <span class="absolute -top-1 -right-1 flex h-4 w-4">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-primary opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-4 w-4 bg-brand-primary border-2 border-white dark:border-slate-800"></span>
                    </span>
                }
            </button>
        </div>

        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
        {
            <a asp-action="Add3DPrint" class="bg-brand-primary text-white p-4 rounded-full shadow-lg hover:scale-110 transition-transform">
                <i class="bi bi-plus-lg text-2xl"></i>
            </a>
        }
    </div>

    @* Collapsible Filter Panel *@
    <div id="filterPanel"
         class="overflow-hidden transition-all duration-500 ease-in-out"
         style="max-height: @(isFiltering ? "1000px" : "0px"); opacity: @(isFiltering ? "1" : "0"); margin-bottom: @(isFiltering ? "3rem" : "0px");">

        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-8 shadow-sm transition-colors duration-500">
            <form asp-action="Articles" method="get" class="space-y-8">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                    @* Search Text *@
                    <div class="md:col-span-2 relative">
                        <label class="block text-xs font-bold text-slate-400 dark:text-slate-500 uppercase mb-2.5 ml-1">Търсене по име</label>
                        <div class="relative">
                            <input type="text" name="SearchString" value="@Model.SearchString"
                                   placeholder="Напр. Dragon, Keychain..."
                                   class="w-full bg-slate-50 dark:bg-slate-800 border-none rounded-2xl py-3.5 pl-11 pr-4 text-slate-900 dark:text-white focus:ring-2 focus:ring-brand-primary/20 transition-all outline-none" />
                            <i class="bi bi-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 dark:text-slate-500"></i>
                        </div>
                    </div>

                    @* Type Filter *@
                    <div>
                        <label class="block text-xs font-bold text-slate-400 dark:text-slate-500 uppercase mb-2.5 ml-1">Категория</label>
                        <select name="SelectedType" class="w-full bg-slate-50 dark:bg-slate-800 border-none rounded-2xl py-3.5 px-4 text-slate-900 dark:text-white focus:ring-2 focus:ring-brand-primary/20 transition-all cursor-pointer outline-none">
                            <option value="">Всички категории</option>
                            @foreach (var type in Enum.GetValues<PrintType>())
                            {
                                <option value="@type" selected="@(Model.SelectedType == type)">@type.ToString()</option>
                            }
                        </select>
                    </div>

                    @* Material Filter *@
                    <div>
                        <label class="block text-xs font-bold text-slate-400 dark:text-slate-500 uppercase mb-2.5 ml-1">Материал</label>
                        <select name="SelectedMaterial" class="w-full bg-slate-50 dark:bg-slate-800 border-none rounded-2xl py-3.5 px-4 text-slate-900 dark:text-white focus:ring-2 focus:ring-brand-primary/20 transition-all cursor-pointer outline-none">
                            <option value="">Всички материали</option>
                            @foreach (var mat in Enum.GetValues<MaterialType>())
                            {
                                <option value="@mat" selected="@(Model.SelectedMaterial == mat)">@mat.ToString()</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="flex flex-wrap items-end justify-between gap-6 pt-6 border-t border-slate-100 dark:border-slate-800">
                    @* Price Range *@
                    <div class="flex items-center gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-400 dark:text-slate-500 uppercase mb-2">Мин. Цена</label>
                            <input type="number" name="MinPrice" value="@Model.MinPrice" placeholder="0" step="0.01"
                                   class="w-28 bg-slate-50 dark:bg-slate-800 border-none rounded-xl py-2.5 px-4 text-slate-900 dark:text-white focus:ring-2 focus:ring-brand-primary/20 outline-none" />
                        </div>
                        <div class="mb-2.5 text-slate-300 dark:text-slate-700">—</div>
                        <div>
                            <label class="block text-xs font-bold text-slate-400 dark:text-slate-500 uppercase mb-2">Макс. Цена</label>
                            <input type="number" name="MaxPrice" value="@Model.MaxPrice" placeholder="999" step="0.01"
                                   class="w-28 bg-slate-50 dark:bg-slate-800 border-none rounded-xl py-2.5 px-4 text-slate-900 dark:text-white focus:ring-2 focus:ring-brand-primary/20 outline-none" />
                        </div>
                    </div>

                    @* Action Buttons *@
                    <div class="flex items-center gap-3">
                        @if (isFiltering)
                        {
                            <a asp-action="Articles" class="px-6 py-3.5 text-slate-500 dark:text-slate-400 font-bold hover:text-red-500 transition-colors">
                                Изчисти филтрите
                            </a>
                        }
                        <button type="submit" class="px-10 py-3.5 bg-brand-primary text-white font-bold rounded-2xl hover:bg-brand-dark shadow-lg shadow-brand-primary/20 dark:shadow-none transition-all active:scale-95">
                            Приложи филтрите
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @* --- Main Content Area --- *@
    <div class="mt-8">
        @if (isFiltering)
        {
            @if (!Model.Results.Any())
            {
                <div class="py-24 text-center bg-slate-50 dark:bg-slate-900/40 rounded-[3rem] border-2 border-dashed border-slate-200 dark:border-slate-800 transition-colors">
                    <div class="w-20 h-20 bg-white dark:bg-slate-800 rounded-full flex items-center justify-center mx-auto mb-6 shadow-sm">
                        <i class="bi bi-search text-3xl text-slate-300 dark:text-slate-600"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-slate-600 dark:text-slate-400">Няма открити резултати</h3>
                    <p class="text-slate-400 dark:text-slate-500 mt-2">Опитайте да промените критериите или изчистете филтрите.</p>
                </div>
            }
            else
            {
                <div class="flex items-center justify-between mb-8 px-2">
                    <h2 class="text-2xl font-black text-brand-dark dark:text-white">Резултати <span class="text-brand-primary ml-1">(@Model.Results.Count)</span></h2>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12">
                    @foreach (var item in Model.Results)
                    {
                        <partial name="_ProductCard" model="item" />
                    }
                </div>
            }
        }
        else
        {
            await RenderStoreSection("Фигурки", Model.RecentFigures, PrintType.Figure);
            await RenderStoreSection("Играчки", Model.RecentFidgetToys, PrintType.FidgetToy);
            await RenderStoreSection("Аксесоари", Model.RecentAccessories, PrintType.Accessory);
        }
    </div>
</div>

@section Scripts {
    <script>
        function toggleFilters() {
            const panel = document.getElementById('filterPanel');
            const icon = document.getElementById('filterIcon');

            if (panel.style.maxHeight === "0px" || panel.style.maxHeight === "") {
                panel.style.maxHeight = "1000px";
                panel.style.opacity = "1";
                panel.style.marginBottom = "3rem";
                icon.classList.add('rotate-90', 'text-brand-primary');
            } else {
                panel.style.maxHeight = "0px";
                panel.style.opacity = "0";
                panel.style.marginBottom = "0px";
                icon.classList.remove('rotate-90', 'text-brand-primary');
            }
        }

        // --- Add to Cart Logic ---
        let addCount = 0;
        let hideTimeout;

        async function addToCart(event, form) {
            event.preventDefault();
            const button = form.querySelector('button');
            const originalText = button.innerHTML;

            try {
                const formData = new FormData(form);
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                });

                if (response.url.includes("Account/Login")) {
                    window.location.href = response.url;
                    return;
                }

                if (response.ok) {
                    button.disabled = true;
                    button.innerHTML = '<i class="bi bi-check2 text-lg"></i>';
                    button.classList.add('bg-green-500', 'text-white', 'border-green-500');

                    const msg = document.getElementById('cart-status-msg');
                    const cartIcon = document.querySelector('#cart-nav-link i');

                    if (msg) {
                        addCount++;
                        msg.innerText = addCount > 1 ? `+${addCount} добавени!` : '+1 добавен!';
                        msg.classList.remove('opacity-0', 'translate-y-[-5px]');
                        msg.classList.add('opacity-100', 'translate-y-0');

                        if (cartIcon) {
                            cartIcon.classList.add('scale-125', 'text-brand-primary');
                            setTimeout(() => cartIcon.classList.remove('scale-125', 'text-brand-primary'), 200);
                        }

                        clearTimeout(hideTimeout);
                        hideTimeout = setTimeout(() => {
                            msg.classList.replace('opacity-100', 'opacity-0');
                            msg.classList.replace('translate-y-0', 'translate-y-[-5px]');
                            addCount = 0;
                        }, 2500);
                    }
                }
            } catch (error) {
                console.error("Грешка:", error);
            }

            setTimeout(() => {
                button.disabled = false;
                button.innerHTML = originalText;
                button.classList.remove('bg-green-500', 'text-white', 'border-green-500');
            }, 800);
        }
    </script>
}