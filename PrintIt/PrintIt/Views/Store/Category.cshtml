@model List<PrintIt.Models.Print>
@{
    var categoryName = ViewData["CategoryName"] as string ?? "Артикули";
    ViewData["Title"] = categoryName;
}

<div class="max-w-7xl mx-auto px-4 pt-4 pb-20">
    @* Header *@
    <div class="mb-12 -mt-2 border-b border-slate-100 pb-8">
        <h1 class="text-5xl font-black text-brand-dark tracking-tight">@categoryName</h1>
        <p class="text-slate-500 mt-2 text-lg">Всички налични модели в категорията.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12">
        @foreach (var item in Model)
        {
            <partial name="_ProductCard" model="item" />
        }
    </div>
</div>