@using Microsoft.AspNetCore.Identity
@using PrintIt.Enums

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PrintIt 3D</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: { sans: ['Plus Jakarta Sans', 'sans-serif'] },
                    colors: {
                        'brand-dark': '#0f172a',
                        'brand-primary': '#3b82f6',
                        'brand-accent': '#f59e0b',
                        'brand-surface': '#f8fafc',
                    }
                }
            }
        }
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        /* --- Performance Optimized Transitions --- */
        html {
            background-color: #f8fafc;
        }

            html.dark {
                background-color: #020617;
            }

        /* No opacity on body to prevent blinking */
        body {
            margin: 0;
            padding: 0;
        }

        /* Animation happens only on this wrapper */
        .fade-wrapper {
            animation: fadeIn 0.15s ease-out forwards;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(2px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* --- UI Styles --- */
        .nav-link {
            position: relative;
            padding: 0.5rem 0;
        }

            .nav-link::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                width: 0;
                height: 2px;
                background: #3b82f6;
                transition: width 0.3s ease;
            }

            .nav-link:hover::after {
                width: 100%;
            }

        .blueprint-bg {
            background-image: radial-gradient(#e2e8f0 0.8px, transparent 0.8px);
            background-size: 24px 24px;
            background-color: #f8fafc;
        }

        .dark .blueprint-bg {
            background-image: radial-gradient(#1e293b 0.8px, transparent 0.8px);
            background-color: #020617;
        }

        .flyer-item {
            position: fixed;
            z-index: 9999;
            pointer-events: none;
            transition: all 0.8s cubic-bezier(0.42, 0, 0.58, 1);
        }

        @@keyframes cartPop {
            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.4);
                color: #3b82f6;
            }

            100% {
                transform: scale(1);
            }
        }

        .cart-pop {
            animation: cartPop 0.4s ease-out;
        }
    </style>

    <script>
        // Set theme immediately to prevent theme-flicker
        if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
</head>
<body class="bg-brand-surface dark:bg-[#020617] text-slate-900 dark:text-slate-100 font-sans antialiased min-h-screen flex flex-col">

    <header class="sticky top-0 z-50 bg-white/90 dark:bg-[#0f172a]/90 backdrop-blur-xl border-b border-slate-200 dark:border-slate-800">
        <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-20">
                <div class="flex items-center gap-10">
                    <a class="flex items-center gap-3 group" asp-area="" asp-controller="Home" asp-action="Index">
                        <div class="relative">
                            <div class="bg-brand-dark dark:bg-brand-primary p-2 rounded-lg transition-transform group-hover:scale-105">
                                <i class="bi bi-box-seam text-white text-xl"></i>
                            </div>
                            <div class="absolute -bottom-1 -right-1 w-3 h-3 bg-brand-primary dark:bg-brand-dark rounded-full border-2 border-white dark:border-slate-800"></div>
                        </div>
                        <div class="flex flex-col leading-none">
                            <span class="text-xl font-extrabold tracking-tight text-slate-900 dark:text-white transition-colors">
                                PRINT<span class="text-slate-400">IT</span><span class="text-brand-primary">3D</span>
                            </span>
                            <span class="text-[10px] uppercase tracking-[0.2em] font-bold text-slate-400">Lab & Articles</span>
                        </div>
                    </a>

                    <div class="hidden md:flex items-center space-x-8">
                        <div class="relative group">
                            <a class="nav-link text-sm font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300 hover:text-brand-primary dark:hover:text-white transition-colors flex items-center gap-1 py-4"
                               asp-area="" asp-controller="Store" asp-action="Articles">
                                <i class="bi bi-grid-3x3-gap"></i> Артикули
                                <i class="bi bi-chevron-down text-[10px] transition-transform group-hover:rotate-180"></i>
                            </a>
                            <div class="absolute left-0 top-full w-48 bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 shadow-xl rounded-2xl py-2 opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all z-50">
                                <a class="flex items-center gap-3 px-4 py-3 text-sm font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-brand-primary dark:hover:text-white transition-colors"
                                   asp-controller="Store" asp-action="Category" asp-route-type="@PrintType.Figure.ToString()">
                                    <i class="bi bi-person-bounding-box text-brand-primary"></i> Фигурки
                                </a>
                                <a class="flex items-center gap-3 px-4 py-3 text-sm font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-brand-primary dark:hover:text-white transition-colors"
                                   asp-controller="Store" asp-action="Category" asp-route-type="@PrintType.FidgetToy.ToString()">
                                    <i class="bi bi-controller text-brand-primary"></i> Играчки
                                </a>
                                <a class="flex items-center gap-3 px-4 py-3 text-sm font-bold text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-800 hover:text-brand-primary dark:hover:text-white transition-colors"
                                   asp-controller="Store" asp-action="Category" asp-route-type="@PrintType.Accessory.ToString()">
                                    <i class="bi bi-watch text-brand-primary"></i> Аксесоари
                                </a>
                            </div>
                        </div>
                        <a class="nav-link text-sm font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300 hover:text-brand-primary dark:hover:text-white transition-colors flex items-center gap-2 py-4"
                           asp-area="" asp-controller="Order" asp-action="Index">
                            <i class="bi bi-puzzle"></i> Поръчка
                        </a>
                    </div>
                </div>

                <div class="flex items-center space-x-6">
                    <partial name="_LoginPartial" />
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        @await Component.InvokeAsync("CartCount")
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="fixed bottom-8 right-8 z-50">
        <button id="theme-toggle" class="relative w-14 h-14 flex items-center justify-center rounded-full bg-white dark:bg-slate-800 shadow-2xl border border-slate-200 dark:border-slate-700 hover:scale-110 active:scale-95 transition-all duration-300 group overflow-hidden">
            <i id="theme-toggle-light-icon" class="bi bi-sun-fill text-2xl text-brand-accent transition-all duration-500 absolute rotate-0 scale-100 dark:-rotate-90 dark:scale-0"></i>
            <i id="theme-toggle-dark-icon" class="bi bi-moon-stars-fill text-2xl text-brand-primary transition-all duration-500 absolute rotate-90 scale-0 dark:rotate-0 dark:scale-100"></i>
        </button>
    </div>

    <main role="main" class="flex-grow blueprint-bg">
        <div class="fade-wrapper max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            <div class="bg-white/70 dark:bg-slate-900/70 backdrop-blur-md rounded-3xl p-6 md:p-10 shadow-2xl border border-slate-200/60 dark:border-slate-800/60 min-h-[70vh]">
                @RenderBody()
            </div>
        </div>
    </main>

    <footer class="bg-slate-950 text-slate-300 pt-20 pb-10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-12 pb-16 border-b border-slate-800">
                <div class="col-span-1 md:col-span-2">
                    <span class="text-white text-2xl font-black">PRINTIT<span class="text-brand-primary">3D</span></span>
                    <p class="mt-4 text-slate-400 max-w-sm leading-relaxed">
                        От прототипи до готови продукти.
                    </p>
                </div>
                <div>
                    <h4 class="text-white font-bold mb-6 text-sm uppercase tracking-widest">Магазин</h4>
                    <ul class="space-y-4 text-sm">
                        <li><a asp-controller="Store" asp-action="Category" asp-route-type="Figure" class="hover:text-brand-primary transition-colors">3D Фигури</a></li>
                        <li><a asp-controller="Store" asp-action="Category" asp-route-type="FidgetToy" class="hover:text-brand-primary transition-colors">Играчки</a></li>
                        <li><a asp-controller="Store" asp-action="Category" asp-route-type="Accessory" class="hover:text-brand-primary transition-colors">Аксесоари</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-white font-bold mb-6 text-sm uppercase tracking-widest">Контакт</h4>
                    <ul class="space-y-4 text-sm">
                        <li class="flex items-center gap-3"><i class="bi bi-envelope text-brand-primary"></i> 26.print.it@gmail.com</li>
                    </ul>
                </div>
            </div>
            <div class="mt-10 flex flex-col md:flex-row justify-between items-center gap-6">
                <p class="text-xs">&copy; 2026 PrintIt 3D Shop.</p>
                <div class="flex gap-8">
                    <a href="https://www.instagram.com/print_it26/" target="_blank" class="text-slate-500 hover:text-white transition-colors">
                        <i class="bi bi-instagram text-xl"></i>
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <script>
        // --- Dark Mode ---
        const themeToggleBtn = document.getElementById('theme-toggle');
        if (themeToggleBtn) {
            themeToggleBtn.addEventListener('click', function() {
                const isDark = document.documentElement.classList.toggle('dark');
                localStorage.setItem('color-theme', isDark ? 'dark' : 'light');
            });
        }

        // --- Global Cart Refresh ---
        window.refreshCartUI = async function() {
            try {
                const response = await fetch('/Cart/GetCartCount');
                const count = await response.json();
                const badge = document.getElementById('cart-badge');
                const countText = document.getElementById('cart-count-text');
                if (badge && countText) {
                    countText.innerText = count;
                    badge.classList.toggle('hidden', count <= 0);
                    badge.classList.toggle('flex', count > 0);
                }
            } catch (err) { console.error("Cart Sync Error:", err); }
        };

        // --- Cart Animation ---
        function animateFlyToCart(startElement, customColor = '#3b82f6', newTotal = null, loopCount = 1) {
            const cartIcon = document.getElementById('cart-icon-target');
            if (!cartIcon || !startElement) return;

            if (newTotal !== null) {
                const countText = document.getElementById('cart-count-text');
                const badge = document.getElementById('cart-badge');
                if(countText && badge) {
                    countText.innerText = newTotal;
                    badge.classList.remove('hidden');
                    badge.classList.add('flex');
                }
            }

            for (let i = 0; i < loopCount; i++) {
                setTimeout(() => {
                    const flyer = document.createElement('div');
                    flyer.className = 'flyer-item';
                    flyer.innerHTML = `<i class="bi bi-box-seam-fill" style="color: ${customColor}; font-size: 24px;"></i>`;
                    const startRect = startElement.getBoundingClientRect();
                    const cartRect = cartIcon.getBoundingClientRect();
                    flyer.style.left = `${startRect.left + (startRect.width / 2) - 12}px`;
                    flyer.style.top = `${startRect.top + (startRect.height / 2) - 12}px`;
                    document.body.appendChild(flyer);

                    requestAnimationFrame(() => {
                        flyer.style.left = `${cartRect.left}px`;
                        flyer.style.top = `${cartRect.top}px`;
                        flyer.style.transform = 'scale(0.3) rotate(720deg)';
                        flyer.style.opacity = '0';
                    });

                    flyer.addEventListener('transitionend', () => {
                        flyer.remove();
                        if (i === loopCount - 1) {
                            cartIcon.parentElement.classList.add('cart-pop');
                            setTimeout(() => cartIcon.parentElement.classList.remove('cart-pop'), 400);
                        }
                    });
                }, i * 100);
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>