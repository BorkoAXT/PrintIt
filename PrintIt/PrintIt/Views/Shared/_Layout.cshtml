@using Microsoft.AspNetCore.Identity
@using PrintIt.Enums

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PrintIt 3D</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Plus Jakarta Sans', 'sans-serif'] },
                    colors: {
                        'brand-dark': '#0f172a',
                        'brand-primary': '#3b82f6',
                        'brand-accent': '#f59e0b',
                        'brand-surface': '#f8fafc',
                    }
                }
            }
        }
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        .nav-link {
            position: relative;
            padding: 0.5rem 0;
        }

            .nav-link::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                width: 0;
                height: 2px;
                background: #3b82f6;
                transition: width 0.3s ease;
            }

            .nav-link:hover::after {
                width: 100%;
            }

        .blueprint-bg {
            background-image: radial-gradient(#e2e8f0 0.5px, transparent 0.5px);
            background-size: 20px 20px;
        }

        /* Animation for the flying box */
        .flyer-item {
            position: fixed;
            z-index: 9999;
            pointer-events: none;
            transition: all 0.8s cubic-bezier(0.42, 0, 0.58, 1);
        }

        /* Cart Pop/Bounce Effect */
        .cart-pop {
            animation: cartPop 0.4s ease-out;
        }

        @@keyframes cartPop {
            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.4);
                color: #3b82f6;
            }

            100% {
                transform: scale(1);
            }
        }
    </style>
</head>
<body class="bg-brand-surface text-brand-dark font-sans antialiased min-h-screen flex flex-col">

    <header class="sticky top-0 z-50 bg-white/80 backdrop-blur-xl border-b border-slate-200">
        <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-20">

                @* Logo and Navigation *@
                <div class="flex items-center gap-10">
                    <a class="flex items-center gap-3 group" asp-area="" asp-controller="Home" asp-action="Index">
                        <div class="relative">
                            <div class="bg-brand-dark p-2 rounded-lg transition-transform group-hover:scale-105">
                                <i class="bi bi-box-seam text-white text-xl"></i>
                            </div>
                            <div class="absolute -bottom-1 -right-1 w-3 h-3 bg-brand-primary rounded-full border-2 border-white"></div>
                        </div>
                        <div class="flex flex-col leading-none">
                            <span class="text-xl font-extrabold tracking-tight">PRINTIT<span class="text-brand-primary">3D</span></span>
                            <span class="text-[10px] uppercase tracking-[0.2em] font-bold text-slate-400">Lab & Articles</span>
                        </div>
                    </a>

                    <div class="flex items-center space-x-8">
                        <div class="relative group">
                            <a class="nav-link text-sm font-bold uppercase tracking-wider text-slate-600 hover:text-brand-primary transition-colors flex items-center gap-1 py-4"
                               asp-area="" asp-controller="Store" asp-action="Articles">
                                <i class="bi bi-grid-3x3-gap"></i> Артикули
                                <i class="bi bi-chevron-down text-[10px] transition-transform group-hover:rotate-180"></i>
                            </a>
                            <div class="absolute left-0 top-full w-48 bg-white border border-slate-100 shadow-xl rounded-2xl py-2 opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all z-50">
                                <a class="flex items-center gap-3 px-4 py-3 text-sm font-bold text-slate-600 hover:bg-slate-50 hover:text-brand-primary transition-colors"
                                   asp-controller="Store" asp-action="Category" asp-route-type="@PrintType.Figure.ToString()">
                                    <i class="bi bi-person-bounding-box text-brand-primary"></i> Фигурки
                                </a>
                                <a class="flex items-center gap-3 px-4 py-3 text-sm font-bold text-slate-600 hover:bg-slate-50 hover:text-brand-primary transition-colors"
                                   asp-controller="Store" asp-action="Category" asp-route-type="@PrintType.FidgetToy.ToString()">
                                    <i class="bi bi-controller text-brand-primary"></i> Играчки
                                </a>
                                <a class="flex items-center gap-3 px-4 py-3 text-sm font-bold text-slate-600 hover:bg-slate-50 hover:text-brand-primary transition-colors"
                                   asp-controller="Store" asp-action="Category" asp-route-type="@PrintType.Accessory.ToString()">
                                    <i class="bi bi-watch text-brand-primary"></i> Аксесоари
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                @* Right side: Login and Cart *@
                <div class="flex items-center space-x-6">
                    <partial name="_LoginPartial" />

                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
	                    @await Component.InvokeAsync("CartCount")
                    }
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow blueprint-bg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            <div class="bg-white/50 backdrop-blur-sm rounded-3xl p-4 md:p-8 shadow-sm border border-slate-200/60 min-h-[60vh]">
                @RenderBody()
            </div>
        </div>
    </main>

    <footer class="bg-slate-950 text-slate-300 pt-10 pb-10 text-center">
        <p class="text-xs">&copy; 2026 PrintIt 3D. Всички права запазени.</p>
    </footer>

    @* Global Scripts *@
    <script>
        function animateFlyToCart(startElement, customColor = '#3b82f6', newTotal = null, loopCount = 1) {
            const cartIcon = document.getElementById('cart-icon-target');
            const badge = document.getElementById('cart-badge');
            const countText = document.getElementById('cart-count-text');

            if (!cartIcon || !startElement) return;

            // 1. INSTANT UI UPDATE
            // This ensures the user doesn't have to wait for the animation or a page switch
            if (newTotal !== null && countText && badge) {
                countText.innerText = newTotal;
                badge.classList.remove('hidden');
                badge.classList.add('flex');
            }

            // 2. VISUAL FEEDBACK (FLYING BOXES)
            for (let i = 0; i < loopCount; i++) {
                setTimeout(() => {
                    const flyer = document.createElement('div');
                    flyer.className = 'flyer-item';
                    flyer.innerHTML = `<i class="bi bi-box-seam-fill" style="color: ${customColor}; font-size: 24px;"></i>`;

                    const startRect = startElement.getBoundingClientRect();
                    const cartRect = cartIcon.getBoundingClientRect();

                    flyer.style.left = `${startRect.left + (startRect.width / 2) - 12}px`;
                    flyer.style.top = `${startRect.top + (startRect.height / 2) - 12}px`;
                    document.body.appendChild(flyer);

                    requestAnimationFrame(() => {
                        flyer.style.left = `${cartRect.left}px`;
                        flyer.style.top = `${cartRect.top}px`;
                        flyer.style.transform = 'scale(0.3) rotate(720deg)';
                        flyer.style.opacity = '0';
                    });

                    flyer.addEventListener('transitionend', () => {
                        flyer.remove();
                        if (i === loopCount - 1) {
                            cartIcon.parentElement.classList.add('cart-pop');
                            setTimeout(() => cartIcon.parentElement.classList.remove('cart-pop'), 400);
                        }
                    });
                }, i * 100);
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>