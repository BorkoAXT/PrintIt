@model PrintIt.Models.Print

<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

@* 1. Added ID and view-transition-name *@
<div id="product-card-@Model.Id"
     class="group relative flex flex-col h-full product-card"
     x-data="{ showDeleteModal: false }"
     style="view-transition-name: card-@Model.Id;">

    @* Image with hover effect *@
    <div class="aspect-square w-full overflow-hidden rounded-2xl bg-slate-100 border border-slate-200 transition-all group-hover:shadow-xl group-hover:shadow-brand-primary/10 group-hover:-translate-y-1">
        @{
            var imagePath = !string.IsNullOrEmpty(Model.FilePath) ? Model.FilePath : "/images/placeholder-figure.jpg";
        }
        <img src="@imagePath" alt="@Model.Name" class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-110" />

        <div class="absolute inset-0 bg-brand-dark/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center z-20">
            <a asp-controller="Store" asp-action="Details" asp-route-id="@Model.Id" class="bg-white text-brand-dark px-4 py-2 rounded-lg font-bold text-sm shadow-xl transform translate-y-4 group-hover:translate-y-0 transition-transform">
                Виж детайли
            </a>
        </div>
    </div>

    @* Info *@
    <div class="mt-4 flex flex-col flex-grow">
        <div class="flex justify-between items-start gap-2">
            <h3 class="text-base font-bold text-brand-dark truncate">
                <a asp-controller="Store" asp-action="Details" asp-route-id="@Model.Id" class="hover:text-brand-primary transition-colors">@Model.Name</a>
            </h3>
            <p class="text-lg font-black text-brand-primary whitespace-nowrap">€ @Model.Price.ToString("F2")</p>
        </div>

        <p class="mt-1 text-xs font-medium text-slate-400 uppercase tracking-tighter">
            <i class="bi bi-cpu text-brand-primary"></i> 3D принтирано
        </p>

        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
        {
            <div class="mt-auto pt-3 flex gap-2">
                <a asp-controller="Store" asp-action="Edit" asp-route-id="@Model.Id"
                   class="flex-1 py-2 bg-brand-primary hover:bg-brand-dark text-white font-bold rounded-xl transition-all text-sm text-center">
                    Редактирай
                </a>

                <button type="button"
                        @@click="showDeleteModal = true"
                        class="flex-1 py-2 bg-red-50 hover:bg-red-500 hover:text-white border border-red-200 text-red-500 font-bold rounded-xl transition-all text-sm">
                    Изтрий
                </button>
            </div>
        }
    </div>

    @* Delete Confirmation Modal *@
    <template x-teleport="body">
        <div x-show="showDeleteModal"
             style="display: none;"
             x-cloak
             class="fixed inset-0 z-[100] flex items-center justify-center p-4">

            @* Backdrop overlay *@
            <div x-show="showDeleteModal"
                 x-transition:enter="ease-out duration-300"
                 x-transition:enter-start="opacity-0"
                 x-transition:enter-end="opacity-100"
                 x-transition:leave="ease-in duration-200"
                 x-transition:leave-start="opacity-100"
                 x-transition:leave-end="opacity-0"
                 @@click="showDeleteModal = false"
                 class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm"></div>

            @* Modal Dialog Box *@
            <div x-show="showDeleteModal"
                 x-transition:enter="ease-out duration-300"
                 x-transition:enter-start="opacity-0 scale-95 translate-y-4"
                 x-transition:enter-end="opacity-100 scale-100 translate-y-0"
                 x-transition:leave="ease-in duration-200"
                 x-transition:leave-start="opacity-100 scale-100 translate-y-0"
                 x-transition:leave-end="opacity-0 scale-95 translate-y-4"
                 class="relative bg-white rounded-2xl shadow-2xl max-w-sm w-full p-6 text-center">

                <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-red-100 mb-4">
                    <i class="bi bi-exclamation-triangle text-red-600 text-xl"></i>
                </div>

                <h3 class="text-lg font-bold text-slate-900">Изтриване на продукт</h3>
                <p class="text-sm text-slate-500 mt-2">
                    Сигурни ли сте, че искате да изтриете <span class="font-semibold text-slate-800">"@Model.Name"</span>?
                </p>

                <div class="mt-6 flex gap-3">
                    <button type="button" x-on:click="showDeleteModal = false"
                            class="flex-1 px-4 py-2.5 bg-slate-100 text-slate-600 font-bold rounded-xl hover:bg-slate-200 transition-colors text-sm">
                        Отказ
                    </button>

                    @* 2. Intercepting the submit event *@
                    <form onsubmit="performDelete(event, '@Model.Id', this)"
                          asp-controller="Store" asp-action="Delete" asp-route-id="@Model.Id"
                          method="post" class="flex-1">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="w-full px-4 py-2.5 bg-red-500 text-white font-bold rounded-xl hover:bg-red-600 transition-colors shadow-lg shadow-red-200 text-sm">
                            Изтрий
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </template>
</div>

<style>
    /* 3. Animation CSS */
    .product-card {
        contain: layout;
    }

    ::view-transition-group(root) {
        animation-duration: 0.4s;
        animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }

    @@keyframes fade-out {
        to {
            opacity: 0;
            transform: scale(0.9);
        }
    }

    ::view-transition-old(card- @Model.Id ) {
        animation: fade-out 0.3s ease-in-out forwards;
    }
</style>

<script>
    // 4. Global function to handle the transition
    if (typeof performDelete !== 'function') {
        window.performDelete = async function(event, id, form) {
            event.preventDefault(); // Stop full page reload

            const card = document.getElementById(`product-card-${id}`);

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: {
                        'RequestVerificationToken': form.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                });

                if (response.ok) {
                    // Start the View Transition
                    if (document.startViewTransition) {
                        document.startViewTransition(() => {
                            card.remove();
                        });
                    } else {
                        card.remove();
                    }
                }
            } catch (err) {
                console.error("Delete failed:", err);
                form.submit(); // Fallback to normal behavior on error
            }
        };
    }
</script>