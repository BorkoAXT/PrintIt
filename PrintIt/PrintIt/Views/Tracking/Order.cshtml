@model PrintIt.Models.Order
@{
    Layout = "_Layout";
    ViewData["Title"] = $"Поръчка #{Model.Id}";

    var steps = new[]
    {
        ("Pending",    "Получена",        "Поръчката е получена и изчаква потвърждение.",  "bi-inbox-fill"),
        ("Processing", "Обработва се",    "Поръчката е потвърдена и се подготвяме.",        "bi-gear-fill"),
        ("Printing",   "Печата се",       "Моделът се принтира в момента.",                "bi-printer-fill"),
        ("Shipped",    "Изпратена",       "Пратката е предадена на куриер.",               "bi-truck"),
        ("Delivered",  "Доставена",       "Поръчката е доставена успешно.",                "bi-check-circle-fill"),
    };

    int currentStep = Array.FindIndex(steps, s => s.Item1 == Model.Status);
    if (currentStep < 0) currentStep = 0;
}

<div class="max-w-3xl mx-auto">

    @* Back link *@
    <a asp-action="Index" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 dark:text-slate-400 hover:text-brand-primary dark:hover:text-brand-primary transition-colors mb-8">
        <i class="bi bi-arrow-left"></i> Всички поръчки
    </a>

    @* Header *@
    <div class="flex flex-wrap items-start justify-between gap-4 mb-10">
        <div>
            <h1 class="text-3xl font-black text-brand-dark dark:text-white tracking-tight">
                Поръчка #@Model.Id
            </h1>
            <p class="text-slate-400 dark:text-slate-500 text-sm mt-1">
                Направена на @Model.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy, HH:mm", new System.Globalization.CultureInfo("bg-BG"))
            </p>
        </div>
        <div class="text-right">
            <p class="text-xs text-slate-400 dark:text-slate-500 uppercase tracking-widest font-bold mb-1">Сума</p>
            <p class="text-3xl font-black text-brand-dark dark:text-white">€@Model.Amount.ToString("F2")</p>
        </div>
    </div>

    @* Status Timeline *@
    <div class="bg-white dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 rounded-3xl p-8 mb-8 shadow-sm">
        <h2 class="text-sm font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-8">Статус на поръчката</h2>

        <div class="relative">
            @* Progress bar track *@
            <div class="absolute top-5 left-5 right-5 h-0.5 bg-slate-200 dark:bg-slate-700 hidden sm:block"></div>
            @* Progress bar fill *@
            @{
                double pct = steps.Length > 1 ? (double)currentStep / (steps.Length - 1) * 100 : 100;
            }
            <div class="absolute top-5 left-5 h-0.5 bg-brand-primary hidden sm:block transition-all duration-700"
                 style="width: calc((@pct% * (100% - 2.5rem)) / 100)"></div>

            <div class="grid grid-cols-1 sm:grid-cols-5 gap-6 sm:gap-2 relative">
                @for (int i = 0; i < steps.Length; i++)
                {
                    var (key, label, desc, icon) = steps[i];
                    bool done    = i <= currentStep;
                    bool current = i == currentStep;

                    string circleClass = done
                        ? "bg-brand-primary text-white shadow-lg shadow-brand-primary/40"
                        : "bg-slate-100 dark:bg-slate-700 text-slate-400 dark:text-slate-500";

                    string labelClass = current
                        ? "text-brand-primary font-black"
                        : done
                            ? "text-slate-700 dark:text-slate-200 font-semibold"
                            : "text-slate-400 dark:text-slate-500 font-medium";

                    <div class="flex sm:flex-col items-start sm:items-center gap-4 sm:gap-3 sm:text-center">
                        <div class="relative flex-shrink-0">
                            <div class="w-10 h-10 rounded-full flex items-center justify-center @circleClass transition-all duration-300 z-10 relative">
                                <i class="bi @icon text-base"></i>
                            </div>
                            @if (current)
                            {
                                <span class="absolute inset-0 rounded-full bg-brand-primary/20 animate-ping"></span>
                            }
                        </div>
                        <div class="sm:px-1">
                            <p class="text-sm @labelClass leading-tight">@label</p>
                            @if (current)
                            {
                                <p class="text-xs text-slate-400 dark:text-slate-500 mt-1 leading-snug hidden sm:block">@desc</p>
                            }
                        </div>
                    </div>
                }
            </div>

            @* Current step description on mobile *@
            <div class="mt-6 sm:hidden p-4 bg-brand-primary/5 dark:bg-brand-primary/10 border border-brand-primary/20 rounded-2xl">
                <p class="text-sm text-slate-600 dark:text-slate-300">@steps[currentStep].Item3</p>
            </div>
        </div>
    </div>

    @* Order details *@
    <div class="bg-white dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 rounded-3xl p-8 shadow-sm">
        <h2 class="text-sm font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-6">Детайли</h2>

        <dl class="space-y-4">
            <div class="flex justify-between items-center py-3 border-b border-slate-100 dark:border-slate-700/50">
                <dt class="text-sm text-slate-500 dark:text-slate-400">Имейл</dt>
                <dd class="text-sm font-semibold text-slate-700 dark:text-slate-200">@Model.CustomerEmail</dd>
            </div>
            <div class="flex justify-between items-center py-3 border-b border-slate-100 dark:border-slate-700/50">
                <dt class="text-sm text-slate-500 dark:text-slate-400">Дата на поръчка</dt>
                <dd class="text-sm font-semibold text-slate-700 dark:text-slate-200">
                    @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                </dd>
            </div>
            @if (Model.PaidAt.HasValue)
            {
                <div class="flex justify-between items-center py-3 border-b border-slate-100 dark:border-slate-700/50">
                    <dt class="text-sm text-slate-500 dark:text-slate-400">Платена на</dt>
                    <dd class="text-sm font-semibold text-green-600 dark:text-green-400">
                        @Model.PaidAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </dd>
                </div>
            }
            <div class="flex justify-between items-center py-3">
                <dt class="text-sm text-slate-500 dark:text-slate-400">Обща сума</dt>
                <dd class="text-lg font-black text-brand-dark dark:text-white">€@Model.Amount.ToString("F2")</dd>
            </div>
        </dl>
    </div>

    @* Contact CTA *@
    <div class="mt-6 text-center text-sm text-slate-400 dark:text-slate-500">
        Въпроси? Свържете се с нас на
        <a href="mailto:26.print.it@gmail.com" class="text-brand-primary hover:underline font-semibold">26.print.it@gmail.com</a>
    </div>
</div>
