@{
	ViewData["Title"] = "Тестово Плащане";
}

<div class="min-h-[60vh] flex items-center justify-center px-4">
	<div class="max-w-md w-full bg-white rounded-[2.5rem] p-10 shadow-2xl border-2 border-dashed border-brand-primary/30 text-center">
        
		<div class="h-20 w-20 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-6">
			<i class="bi bi-hammer text-yellow-600 text-3xl"></i>
		</div>

		<h2 class="text-2xl font-black text-brand-dark mb-2">Тестова Среда</h2>
		<p class="text-slate-500 mb-8">Това е симулация на плащане. Натиснете бутона долу, за да потвърдите поръчката.</p>

		<form asp-controller="Order" asp-action="SimulateCallback" method="post">
			@* We pass the encoded string back to the callback action *@
			<input type="hidden" name="encoded" value="@ViewBag.Encoded" />
            
			<button type="submit" class="w-full bg-brand-primary hover:bg-blue-600 text-white py-4 rounded-2xl font-bold shadow-lg transition-all active:scale-95">
				Потвърди Плащането (Debug)
			</button>
		</form>
        
		<a href="/Cart" class="inline-block mt-6 text-slate-400 hover:text-brand-dark text-sm">
			Отказ и връщане към количката
		</a>
	</div>
</div>