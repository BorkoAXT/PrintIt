@model List<UserWishlistItem>
@using Entities.Models
@inject Services.Interfaces.IFileService FileService
@{
    ViewData["Title"] = "Начало";
}

<div class="container mx-auto px-4 py-12 transition-colors duration-500">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="mb-12 text-center">
            <h1 class="text-4xl md:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
                Добре дошли, <span class="text-blue-600 dark:text-blue-400">@User.Identity.Name!</span>
            </h1>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="mb-16">
                <div class="flex items-center gap-4 mb-8">
                    <h2 class="text-xs font-black text-slate-400 dark:text-slate-500 uppercase tracking-[0.3em]">Твоят списък с желания</h2>
                    <div class="h-px bg-slate-200 dark:bg-slate-800 flex-grow"></div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
                    @foreach (var item in Model)
                    {
                        // Get the first image or use placeholder
                        string imageUrl = "/images/placeholder.jpg";
                        var images = FileService.GetPrintImages(item.Print.Id);
                        imageUrl = images.FirstOrDefault() ?? "/images/placeholder.jpg";

                        <div class="group relative flex flex-col">
                            @* Image Container *@
                            <div class="aspect-square w-full overflow-hidden rounded-[2rem] bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 transition-all duration-500 group-hover:shadow-2xl group-hover:shadow-blue-500/20 group-hover:-translate-y-2">
                                <img src="@imageUrl"
                                     alt="@item.Print.Name"
                                     class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" />

                                @* Hover Overlay *@
                                <div class="absolute inset-0 bg-slate-900/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center z-20 backdrop-blur-sm">
                                    <a asp-controller="Store" asp-action="Details" asp-route-id="@item.Print.Id"
                                       class="bg-white text-slate-900 px-6 py-3 rounded-xl font-bold text-sm shadow-xl transform translate-y-4 group-hover:translate-y-0 transition-all duration-300 hover:bg-blue-600 hover:text-white">
                                        Виж детайли
                                    </a>
                                </div>
                            </div>

                            @* Info *@
                            <div class="mt-5 px-2">
                                <h3 class="text-lg font-bold text-slate-900 dark:text-white leading-tight group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">@item.Print.Name</h3>
                                <p class="text-xl font-black text-blue-600 dark:text-blue-400 mt-1">@item.Print.Price.ToString("0.00") лв.</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            @* Empty Wishlist State *@
            <div class="py-20 bg-slate-50 dark:bg-slate-900/50 rounded-[3rem] border-2 border-dashed border-slate-200 dark:border-slate-800 text-center transition-colors">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-400 mb-4">
                    <i class="bi bi-heart text-2xl"></i>
                </div>
                <p class="text-slate-500 dark:text-slate-400 font-bold text-xl">Списъкът ти с желания е все още празен.</p>
                <a asp-controller="Store" asp-action="Articles" class="mt-4 inline-block text-blue-600 dark:text-blue-400 font-bold hover:underline transition-all">Разгледай продуктите тук →</a>
            </div>
        }
    }
    else
    {
        @* Hero Section for Guest Users *@
        <div class="relative overflow-hidden text-center py-24 md:py-32 bg-slate-900 rounded-[3rem] text-white px-6 shadow-2xl shadow-blue-900/20">
            @* Background Decorative Blur *@
            <div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/2 w-96 h-96 bg-blue-600/20 rounded-full blur-[120px]"></div>

            <div class="relative z-10">
                <h1 class="text-6xl md:text-7xl font-black mb-6 tracking-tighter leading-tight">
                    Където идеите <br /> <span class="text-blue-400">оживяват.</span>
                </h1>
                <p class="text-slate-400 text-xl mb-10 max-w-xl mx-auto leading-relaxed">
                    Открийте магията на 3D принтирането с нашите детайлни модели и аксесоари.
                </p>
                <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                    <a asp-controller="Store" asp-action="Articles" class="w-full sm:w-auto bg-blue-600 text-white px-10 py-4 rounded-2xl font-bold text-lg shadow-lg shadow-blue-600/30 hover:bg-blue-500 hover:scale-105 active:scale-95 transition-all">
                        Към магазина
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Register" class="w-full sm:w-auto bg-slate-800 text-white px-10 py-4 rounded-2xl font-bold text-lg hover:bg-slate-700 transition-all border border-slate-700">
                        Регистрация
                    </a>
                </div>
            </div>
        </div>
    }
</div>