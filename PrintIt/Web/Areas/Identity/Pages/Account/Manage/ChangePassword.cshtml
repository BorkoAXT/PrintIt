@page
@using Web.Areas.Identity.Pages.Account.Manage
@model ChangePasswordModel
@{
    ViewData["Title"] = "Смяна на парола";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="space-y-8 transition-colors duration-500">
    @* Header Section *@
    <div class="flex items-center gap-5 border-b border-slate-100 dark:border-slate-800 pb-6">
        <div class="p-3 bg-brand-primary/10 dark:bg-brand-primary/20 rounded-2xl">
            <i class="bi bi-shield-lock-fill text-brand-primary dark:text-blue-400 text-2xl"></i>
        </div>
        <div>
            <h3 class="text-2xl font-black text-brand-dark dark:text-white">@ViewData["Title"]</h3>
            <p class="text-slate-500 dark:text-slate-400 text-base">Актуализирайте паролата си, за да защитите вашия профил.</p>
        </div>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="max-w-xl">
        <form id="change-password-form" method="post" class="space-y-7">
            @* Validation Summary *@
            <div asp-validation-summary="ModelOnly"
                 class="text-red-600 dark:text-red-400 text-sm bg-red-50 dark:bg-red-900/20 p-4 rounded-2xl mb-6 border border-red-100 dark:border-red-900/30" role="alert">
            </div>

            @* Current Password *@
            <div class="space-y-2">
                <label asp-for="Input.OldPassword" class="block text-sm font-bold text-slate-700 dark:text-slate-300 ml-1">Текуща парола</label>
                <div class="relative group">
                    <input asp-for="Input.OldPassword"
                           class="w-full px-5 py-4 bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-brand-primary/10 dark:focus:ring-brand-primary/5 focus:border-brand-primary outline-none transition-all placeholder:text-slate-400 dark:placeholder:text-slate-600 text-base shadow-sm dark:text-white"
                           autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Input.OldPassword" class="text-red-500 dark:text-red-400 text-sm font-medium mt-2 ml-1 block"></span>
            </div>

            @* New Password *@
            <div class="space-y-2 pt-2">
                <label asp-for="Input.NewPassword" class="block text-sm font-bold text-slate-700 dark:text-slate-300 ml-1">Нова парола</label>
                <div class="relative group">
                    <input asp-for="Input.NewPassword"
                           class="w-full px-5 py-4 bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-brand-primary/10 dark:focus:ring-brand-primary/5 focus:border-brand-primary outline-none transition-all placeholder:text-slate-400 dark:placeholder:text-slate-600 text-base shadow-sm dark:text-white"
                           autocomplete="new-password" aria-required="true" placeholder="Минимум 6 символа" />
                </div>
                <span asp-validation-for="Input.NewPassword" class="text-red-500 dark:text-red-400 text-sm font-medium mt-2 ml-1 block"></span>
            </div>

            @* Confirm New Password *@
            <div class="space-y-2">
                <label asp-for="Input.ConfirmPassword" class="block text-sm font-bold text-slate-700 dark:text-slate-300 ml-1">Потвърдете новата парола</label>
                <div class="relative group">
                    <input asp-for="Input.ConfirmPassword"
                           class="w-full px-5 py-4 bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-brand-primary/10 dark:focus:ring-brand-primary/5 focus:border-brand-primary outline-none transition-all placeholder:text-slate-400 dark:placeholder:text-slate-600 text-base shadow-sm dark:text-white"
                           autocomplete="new-password" aria-required="true" placeholder="Повторете новата парола" />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-red-500 dark:text-red-400 text-sm font-medium mt-2 ml-1 block"></span>
            </div>

            @* Submit Button *@
            <div class="pt-4">
                <button type="submit"
                        class="w-full sm:w-auto px-12 py-4 bg-brand-dark dark:bg-brand-primary hover:bg-brand-primary dark:hover:bg-blue-500 text-white text-base font-bold rounded-2xl shadow-lg hover:shadow-brand-primary/30 transition-all active:scale-[0.98]">
                    Обнови паролата
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}