@page
@using Web.Areas.Identity.Pages.Account.Manage
@model PersonalDataModel
@{
    ViewData["Title"] = "Лични данни";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="space-y-8 transition-colors duration-500">
    @* Header Section *@
    <div class="flex items-center gap-5 border-b border-slate-100 dark:border-slate-800 pb-6">
        <div class="p-3 bg-brand-primary/10 dark:bg-brand-primary/20 rounded-2xl">
            <i class="bi bi-file-earmark-lock-fill text-brand-primary dark:text-blue-400 text-2xl"></i>
        </div>
        <div>
            <h3 class="text-2xl font-black text-brand-dark dark:text-white">@ViewData["Title"]</h3>
            <p class="text-slate-500 dark:text-slate-400 text-base">Управлявайте информацията, която съхраняваме за вас.</p>
        </div>
    </div>

    <div class="max-w-2xl space-y-8">
        @* Information Box *@
        <div class="bg-white/80 dark:bg-slate-900/50 backdrop-blur-xl border border-slate-200 dark:border-slate-800 rounded-[2.5rem] p-8 shadow-sm transition-all">
            <p class="text-slate-600 dark:text-slate-300 text-lg leading-relaxed mb-8">
                Вашият акаунт съдържа лични данни, които сте ни предоставили. Тази страница ви позволява да изтеглите или окончателно да изтриете тези данни.
            </p>

            @* Danger Zone Warning *@
            <div class="p-6 bg-red-50 dark:bg-red-900/10 border border-red-100 dark:border-red-900/30 rounded-3xl flex gap-5 items-start transition-colors">
                <div class="p-2 bg-white dark:bg-red-900/20 rounded-xl shadow-sm">
                    <i class="bi bi-exclamation-triangle-fill text-red-600 dark:text-red-400 text-xl"></i>
                </div>
                <div>
                    <strong class="block text-red-800 dark:text-red-400 text-base font-black mb-1 uppercase tracking-tight">Внимание!</strong>
                    <p class="text-sm text-red-700 dark:text-red-300/80 leading-relaxed">
                        Изтриването на тези данни ще <strong>премахне за постоянно вашия акаунт</strong>. Това действие е необратимо и данните не могат да бъдат възстановени.
                    </p>
                </div>
            </div>
        </div>

        @* Action Buttons *@
        <div class="flex flex-wrap gap-5 pt-2">
            @* Download Button *@
            <form id="download-data" asp-page="DownloadPersonalData" method="post" class="inline-block w-full sm:w-auto">
                <button type="submit"
                        class="w-full sm:w-auto px-10 py-4 bg-brand-dark dark:bg-brand-primary hover:bg-brand-primary dark:hover:bg-blue-500 text-white font-black rounded-2xl shadow-xl shadow-brand-dark/10 transition-all flex items-center justify-center gap-3 text-base active:scale-[0.98]">
                    <i class="bi bi-download text-lg"></i> Изтегли моите данни
                </button>
            </form>

            @* Delete Link *@
            <a id="delete" asp-page="DeletePersonalData"
               class="w-full sm:w-auto px-10 py-4 bg-white dark:bg-transparent border-2 border-red-100 dark:border-red-900/30 text-red-600 dark:text-red-400 hover:bg-red-600 dark:hover:bg-red-600 hover:text-white dark:hover:text-white font-black rounded-2xl transition-all flex items-center justify-center gap-3 text-base shadow-sm active:scale-[0.98]">
                <i class="bi bi-trash3 text-lg"></i> Изтрий акаунта
            </a>
        </div>
    </div>
</div>