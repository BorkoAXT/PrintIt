@page
@using Web.Areas.Identity.Pages.Account.Manage
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Изтриване на профила";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="space-y-8 transition-colors duration-500">
    @* Header Section *@
    <div class="flex items-center gap-5 border-b border-slate-100 dark:border-slate-800 pb-6">
        <div class="p-3 bg-red-50 dark:bg-red-900/20 rounded-2xl">
            <i class="bi bi-person-x-fill text-red-600 dark:text-red-400 text-2xl"></i>
        </div>
        <div>
            <h3 class="text-2xl font-black text-brand-dark dark:text-white">@ViewData["Title"]</h3>
            <p class="text-slate-500 dark:text-slate-400 text-base">Последна стъпка преди окончателното премахване.</p>
        </div>
    </div>

    @* Large Warning Box - Enhanced for Dark Mode *@
    <div class="bg-red-50 dark:bg-red-900/10 border-l-4 border-red-500 p-6 rounded-r-[2rem] shadow-sm dark:shadow-none max-w-2xl">
        <div class="flex items-center gap-4 text-red-800 dark:text-red-400 font-black mb-2">
            <i class="bi bi-exclamation-octagon-fill text-2xl animate-pulse"></i>
            <span class="text-lg">Внимание: Действието е необратимо!</span>
        </div>
        <p class="text-red-700 dark:text-red-300/80 text-base leading-relaxed ml-10">
            Изтриването на тези данни ще <strong>премахне за постоянно вашия акаунт</strong> и цялата свързана информация. Тези данни не могат да бъдат възстановени по-късно.
        </p>
    </div>

    <div class="max-w-md pt-4">
        <form id="delete-user" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly"
                 class="text-red-600 dark:text-red-400 text-sm bg-red-50 dark:bg-red-900/20 p-4 rounded-2xl mb-4 border border-red-100 dark:border-red-900/30" role="alert">
            </div>

            @if (Model.RequirePassword)
            {
                <div class="space-y-2">
                    <label asp-for="Input.Password" class="block text-sm font-bold text-slate-700 dark:text-slate-300 ml-1">Въведете вашата парола</label>
                    <div class="relative group">
                        <input asp-for="Input.Password"
                               class="w-full px-5 py-4 bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-2xl focus:ring-4 focus:ring-red-100 dark:focus:ring-red-900/20 focus:border-red-400 outline-none transition-all placeholder:text-slate-300 dark:placeholder:text-slate-600 text-base shadow-sm dark:text-white"
                               autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Input.Password" class="text-red-500 dark:text-red-400 text-sm font-medium mt-2 ml-1 block"></span>
                </div>
            }

            <div class="pt-2">
                <button type="submit"
                        class="w-full px-8 py-4 bg-red-600 hover:bg-red-700 dark:bg-red-700 dark:hover:bg-red-600 text-white text-base font-black rounded-2xl shadow-lg shadow-red-200 dark:shadow-none transition-all active:scale-[0.98]">
                    Изтрий данните и затвори акаунта ми
                </button>
            </div>

            <div class="text-center">
                <a asp-page="./PersonalData" class="text-slate-500 dark:text-slate-400 hover:text-brand-dark dark:hover:text-white text-sm font-bold transition-colors underline decoration-slate-200 dark:decoration-slate-800 underline-offset-4">
                    Отказ и връщане назад
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}